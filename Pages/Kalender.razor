@page "/Kalender"

@inject ApplicationDbContext Db

<PageTitle>Event Kalender</PageTitle>

@using FerienspassWebApp.Data
@using FerienspassWebApp.Models
@using Microsoft.EntityFrameworkCore

<h1>Event Kalender</h1>

@if (!days.Any())
{
    <p>Keine Events gefunden.</p>
}
else
{
    <div class="day-navigation">

        <button class="btn btn-secondary navigation-button"
                disabled="@(currentDayIndex == 0)"
                @onclick="PreviousDay">
            ← Vorheriger Tag
        </button>

        <div class="day-buttons">
            @for (int i = 0; i < days.Count; i++)
            {
                var index = i;

                <button class="btn @(currentDayIndex == index ? "btn-primary" : "btn-outline-primary") day-button"
                        @onclick="() => GoToDay(index)">
                    @days[index].ToString("dd.MM")
                </button>
            }
        </div>

        <button class="btn btn-secondary navigation-button"
                disabled="@(currentDayIndex == days.Count - 1)"
                @onclick="NextDay">
            Nächster Tag →
        </button>

    </div>

    <h2 class="selected-day">
        @selectedDay?.ToString("dddd dd.MM.yyyy")
    </h2>

    @foreach (var ev in eventsToday)
    {
        <article class="event-card">

            <div class="event-content">

                <h3 class="event-title">Event: @ev.Eventname</h3>

                <div class="event-description">
                    @ev.Beschreibung
                </div>

                <h4>Eventdetails</h4>

                <div class="event-details">
                    <p>
                        <strong>Zeit:</strong>
                        @ev.StartZeit?.ToString("HH:mm") - @ev.EndeZeit?.ToString("HH:mm")
                    </p>

                    <p>
                        <strong>Kategorie:</strong>
                        @ev.Kategorie
                    </p>

                    <p>
                        <strong>Treffpunkt:</strong>
                        @ev.Treffpunkt
                    </p>

                    <p>
                        <strong>Eventlocation:</strong>
                        @ev.Location
                    </p>

                    <p>
                        <strong>Preis:</strong>
                        @ev.price CHF
                    </p>

                    <p>
                        <strong>Mindest- und Maximalkapazität:</strong>
                        @ev.MinKinder - @ev.MaxKinder Kinder
                    </p>

                    <p>
                        <strong>Klassenbeschränkung:</strong>
                        @ev.KlasseMin - @ev.KlasseMax
                    </p>
                </div>

                <h4>Kursleiter</h4>

                @if (ev.Kursleiter?.Any() == true)
                {
                    <div class="course-leaders">
                        @foreach (var kl in ev.Kursleiter)
                        {
                            <p>@kl.User?.Vorname @kl.User?.Nachname</p>
                        }
                    </div>
                }
                else
                {
                    <p>Es ist noch kein Kursleiter definiert.</p>
                }
            </div>

            @if (!string.IsNullOrEmpty(ev.BildUrl))
            {
                <div class="event-image-container">
                    <img src="@ev.BildUrl"
                         class="event-image"
                         alt="Bild zum Event @ev.Eventname" />
                </div>
            }
        </article>
    }
}

<style>
    .day-navigation {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        width: 100%;
    }

    .day-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .navigation-button,
    .day-button {
        white-space: nowrap;
    }

    .selected-day {
        margin-bottom: 16px;
        overflow-wrap: anywhere;
    }

    .event-card {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        width: 100%;
        margin-bottom: 14px;
        padding: 14px;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-sizing: border-box;
        overflow: hidden;
    }

    .event-content {
        flex: 1 1 0;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .event-title {
        margin-top: 0;
        margin-bottom: 14px;
    }

    .event-description {
        margin-bottom: 20px;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .event-details p {
        margin-bottom: 10px;
    }

    .course-leaders p {
        margin-bottom: 6px;
    }

    .event-image-container {
        flex: 0 1 42%;
        width: 42%;
        max-width: 500px;
    }

    .event-image {
        display: block;
        width: 100%;
        height: auto;
        max-height: 500px;
        object-fit: cover;
        border-radius: 10px;
    }

    @@media (max-width: 768px) {
        .day-navigation {
            align-items: stretch;
        }

        .navigation-button {
            flex: 1 1 calc(50% - 4px);
        }

        .day-buttons {
            order: 3;
            width: 100%;
        }

        .day-button {
            flex: 1 1 auto;
        }

        .selected-day {
            font-size: 1.4rem;
        }

        .event-card {
            flex-direction: column;
            gap: 14px;
            padding: 12px;
        }

        .event-image-container {
            order: -1;
            width: 100%;
            max-width: none;
        }

        .event-image {
            width: 100%;
            max-height: 320px;
        }
    }

    @@media (max-width: 480px) {
        .navigation-button {
            flex: 1 1 100%;
            width: 100%;
        }

        .day-button {
            flex: 1 1 calc(33.333% - 8px);
        }

        .event-card {
            padding: 10px;
        }

        .event-title {
            font-size: 1.25rem;
        }

        .event-details p {
            margin-bottom: 12px;
        }
    }
</style>

@code {
    private List<Event> events = new();

    private List<DateTime> days = new();
    private int currentDayIndex = 0;

    private DateTime? selectedDay =>
        days.Any() ? days[currentDayIndex] : null;

    private List<Event> eventsToday =>
        selectedDay == null
            ? new List<Event>()
            : events
                .Where(e => e.StartZeit.HasValue &&
                            e.StartZeit.Value.Date == selectedDay.Value.Date)
                .OrderBy(e => e.StartZeit)
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Now;

        events = await Db.Events
            .AsNoTracking()
            .Include(x => x.Kursleiter)
                .ThenInclude(k => k.User)
            .Where(x => !x.IsDeleted)
            .Where(x => x.StartZeit >= now)
            .OrderBy(x => x.StartZeit)
            .ToListAsync();

        days = events
            .Where(x => x.StartZeit.HasValue)
            .Select(x => x.StartZeit!.Value.Date)
            .Distinct()
            .OrderBy(x => x)
            .ToList();
    }

    private void NextDay()
    {
        if (currentDayIndex < days.Count - 1)
        {
            currentDayIndex++;
        }
    }

    private void PreviousDay()
    {
        if (currentDayIndex > 0)
        {
            currentDayIndex--;
        }
    }

    private void GoToDay(int index)
    {
        if (index >= 0 && index < days.Count)
        {
            currentDayIndex = index;
        }
    }
}

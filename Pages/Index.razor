@page "/"

@implements IDisposable

@using FerienspassWebApp.Services
@using System.Text.RegularExpressions
@using FerienspassWebApp.Models
@using FerienspassWebApp.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using System.Timers

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DocxService DocxService
@inject IWebHostEnvironment Env

<PageTitle>Index</PageTitle>

<h1>Willkommen auf der Startseite von FerienSpass.</h1>

@if (Documents.Count == 0)
{
    <p>Es sind noch keine Informationen vorhanden. Wir freuen uns, Sie bald mit aktuellen Informationen beliefern zu dürfen. Mit den besten Grüssen Ihr FerienSpass Team.</p>
}
else
{
    <h4>Danke für Ihr interesse. Bitte entnehmen Sie die wichtigsten Informationen auf dieser Startseite.</h4>
    <h5 style="color:blue"> Das Konto kann jederzeit ersellt werden, auch vor dem Startdatum der Anmeldung. Klicken Sie dafür einfach auf <a href="Identity/Account/Register">Registrieren</a>. </h5>

    <br />

    <div style="position:relative; background:#f2f2f2; border:1px solid #ccc; border-radius:8px; padding:20px; margin-bottom:20px;">
        <div style="position:absolute;
                    top:-12px;
                    left:-12px;
                    width:30px;
                    height:30px;
                    border-radius:50%;
                    background:blue;
                    color:white;
                    font-weight:bold;
                    display:flex;
                    justify-content:center;
                    align-items:center;
                    border:2px solid white;">
                i
         </div>
        @if (settings != null)
        {
            <h3 style="color:red">20. FERIENSPASS 21.-25. September 2026:</h3>
             @if (isKursleiter)
            {
                <h4> Anmeldungen ab: @settings.KursleiterStart?.ToString("dd.MM.yyyy HH:mm") </h4>
          
                <h4> Anmeldeschluss: @settings.KursleiterEnde?.ToString("dd.MM.yyyy HH:mm")! </h4>
            }
            else
            {
                <h4> Anmeldungen ab: @settings.AnmeldungStart?.ToString("dd.MM.yyyy HH:mm") </h4>

                <h4> Anmeldeschluss: @settings.AnmeldungEnde?.ToString("dd.MM.yyyy HH:mm")  </h4>
            }
        
            <h4 style="color:darkred">Bezahlungen müssen bis am Freitag, dem 11. September 2026 beglichen werden. </h4>
        }
    </div>

    <br />

    <h3>
        Wir danken unseren Sponsoren und HelferInnen ganz herzlich
        für ihre finanzielle, materielle oder persönliche Unterstützung.
        Nur dank ihrer Hilfe ist es uns möglich, den Kindern
        spannende und erschwingliche Kurse anzubieten!
    </h3>
    <br />

    <div style="margin-top:40px;
            padding:15px;
            text-align:center;
            background:lightgreen;
            border-radius:8px;
            font-size:1.3rem;
            font-weight:bold;
            color:darkgreen;">

            Ein Herzliches Dankeschön an unsere Hauptsponsoren:
            <br />
            <br />
            Einwohnergemeinde Rohrbach, 4938 Rohrbach
            <br />
            Einwohnergemeinde Auswil, 4944 Auswil    
            <br />
            Einwohnergemeinde Rohrbachgraben, 4938 Rohrbachgraben

        </div>




    @if (!string.IsNullOrWhiteSpace(AktuellerSponsor))
    {
        
        <div style="margin-top:40px;
            padding:15px;
            text-align:center;
            background:#f2f2f2;
            border-radius:8px;
            font-size:1.3rem;
            font-weight:bold;
            color:green;">

            Danke an unseren Sponsor: @AktuellerSponsor
        </div>
        
    }
}


@code {
    private List<DocItem> Documents = new();
    private SystemSettings? settings;
    private bool isKursleiter;

    private List<string> Sponsoren = new();
    private int sponsorIndex = 0;
    private System.Timers.Timer? sponsorTimer;

    private string AktuellerSponsor =>
        Sponsoren.Count > 0
            ? Sponsoren[sponsorIndex]
            : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        settings = await Db.SystemSettings
            .AsNoTracking()
            .FirstOrDefaultAsync();

        isKursleiter =
            user.IsInRole("Kursleiter") ||
            user.IsInRole("Admin");

        var folder = Path.Combine(
            Env.WebRootPath,
            "configsheets/Informationen");

        if (Directory.Exists(folder))
        {
            var files = Directory.GetFiles(folder, "*.docx");

            Documents = files.Select(file => new DocItem
                {
                    Title = Regex.Replace(
                        Path.GetFileNameWithoutExtension(file),
                        @"\d+\s",
                        ""),
                    Html = DocxService.ConvertToHtml(file)
                }).ToList();
        }

        LoadSponsors();
        StartSponsorTimer();
    }

    private class DocItem
    {
        public string Title { get; set; } = "";
        public string Html { get; set; } = "";
    }

    private void LoadSponsors()
    {
        var sponsorDatei = Path.Combine(
            Env.WebRootPath,
            "configsheets/Informationen",
            "Sponsoren.docx");

        if (!File.Exists(sponsorDatei))
            return;

        var html = DocxService.ConvertToHtml(sponsorDatei);

        // CSS- und Script-Bereiche vollständig entfernen
        html = Regex.Replace(
            html,
            @"<style[^>]*>.*?</style>",
            "",
            RegexOptions.IgnoreCase | RegexOptions.Singleline);

        html = Regex.Replace(
            html,
            @"<script[^>]*>.*?</script>",
            "",
            RegexOptions.IgnoreCase | RegexOptions.Singleline);

        // Absätze und Zeilenumbrüche in echte Zeilenumbrüche umwandeln
        html = Regex.Replace(
            html,
            @"</?(p|div|li|br)[^>]*>",
            "\n",
            RegexOptions.IgnoreCase);

        // Alle übrigen HTML-Tags entfernen
        var text = Regex.Replace(html, @"<[^>]+>", "");

        // HTML-Zeichen wie &amp; zurückwandeln
        text = System.Net.WebUtility.HtmlDecode(text);

        Sponsoren = text
            .Split(
                new[] { '\r', '\n' },
                StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Where(x => !x.Equals("doc", StringComparison.OrdinalIgnoreCase))
            .Distinct()
            .ToList();

        if (Sponsoren.Count > 0)
        {
            sponsorIndex = Random.Shared.Next(Sponsoren.Count);
        }
    }

    private void StartSponsorTimer()
    {
        if (Sponsoren.Count <= 1)
            return;

        sponsorTimer = new System.Timers.Timer(10_000);

        sponsorTimer.Elapsed += async (_, _) =>
        {
            sponsorIndex = Random.Shared.Next(Sponsoren.Count);

            if (sponsorIndex >= Sponsoren.Count)
                sponsorIndex = 0;

            await InvokeAsync(StateHasChanged);
        };

        sponsorTimer.AutoReset = true;
        sponsorTimer.Start();
    }

    public void Dispose()
    {
        sponsorTimer?.Stop();
        sponsorTimer?.Dispose();
    }
}

@code {

    // =========================================================
    // BESTEHENDE DATEN
    // =========================================================

    private List<DocItem> Documents = new();

    private SystemSettings? settings;

    private bool isKursleiter;

    private string WichtigeInformationenHtml = "";


    // =========================================================
    // EVENTS
    // =========================================================

    private List<Event> cancelledEvents = new();

    private List<Event> featuredEvents = new();


    // =========================================================
    // PRIVATE BILDER
    // =========================================================

    private List<string> PrivateBilder = new();

    private int privateBildIndex = 0;

    private System.Timers.Timer? privateBildTimer;


    private string AktuellesPrivatBild =>
        PrivateBilder.Count > 0
            ? PrivateBilder[privateBildIndex]
            : string.Empty;


    // =========================================================
    // SPONSOREN
    // =========================================================

    private List<string> Sponsoren = new();

    private int sponsorIndex = 0;

    private System.Timers.Timer? sponsorTimer;


    private string AktuellerSponsor =>
        Sponsoren.Count > 0
            ? Sponsoren[sponsorIndex]
            : string.Empty;


    // =========================================================
    // INITIALISIERUNG
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await using var Db =
            await DbFactory.CreateDbContextAsync();


        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user =
            authState.User;


        // =====================================================
        // SYSTEM SETTINGS
        // =====================================================

        settings =
            await Db.SystemSettings
                .AsNoTracking()
                .FirstOrDefaultAsync();


        isKursleiter =
            user.IsInRole("Kursleiter") ||
            user.IsInRole("Admin");


        // =====================================================
        // ABGESAGTE ZUKÜNFTIGE EVENTS
        // =====================================================

        cancelledEvents =
            await Db.Events

                .AsNoTracking()

                .Where(x =>
                    !x.IsDeleted &&
                    x.IsCancelled &&
                    x.StartZeit.HasValue &&
                    x.StartZeit.Value >= DateTime.Now)

                .OrderBy(x =>
                    x.StartZeit)

                .ToListAsync();


        // =====================================================
        // VERFÜGBARE EVENTS FÜR STARTSEITE
        // =====================================================

        var availableEvents =
            await Db.Events

                .AsNoTracking()

                .Where(x =>
                    !x.IsDeleted &&
                    !x.IsCancelled &&
                    x.StartZeit.HasValue &&
                    x.StartZeit.Value >= DateTime.Now)

                .ToListAsync();


        // =====================================================
        // 3 ZUFÄLLIGE EVENTS
        // =====================================================

        featuredEvents =
            availableEvents

                .OrderBy(x =>
                    Random.Shared.Next())

                .Take(3)

                .ToList();


        // =====================================================
        // INFORMATIONSDOKUMENTE
        // =====================================================

        var folder =
            Path.Combine(
                Env.WebRootPath,
                "configsheets/Informationen");


        if (Directory.Exists(folder))
        {
            var files =
                Directory.GetFiles(
                        folder,
                        "*.docx")

                    .Where(x =>
                        !Path.GetFileName(x)
                            .Equals(
                                "WichtigeInformationen.docx",
                                StringComparison.OrdinalIgnoreCase))

                    .ToArray();


            Documents =
                files.Select(file =>
                    new DocItem
                        {
                            Title =
                                Regex.Replace(
                                    Path.GetFileNameWithoutExtension(
                                        file),
                                    @"\d+\s",
                                    ""),

                            Html =
                                DocxService.ConvertToHtml(
                                    file)
                        })

                    .ToList();
        }


        // =====================================================
        // WICHTIGE INFORMATIONEN
        // =====================================================

        var wichtigeInfosDatei =
            Path.Combine(
                Env.WebRootPath,
                "configsheets/Informationen",
                "WichtigeInformationen.docx");


        if (File.Exists(wichtigeInfosDatei))
        {
            var html =
                DocxService.ConvertToHtml(
                    wichtigeInfosDatei);


            html =
                Regex.Replace(
                    html,
                    @"<style[^>]*>.*?</style>",
                    "",
                    RegexOptions.IgnoreCase |
                    RegexOptions.Singleline);


            html =
                Regex.Replace(
                    html,
                    @"<script[^>]*>.*?</script>",
                    "",
                    RegexOptions.IgnoreCase |
                    RegexOptions.Singleline);


            html =
                Regex.Replace(
                    html,
                    @"\sstyle\s*=\s*[""'][^""']*[""']",
                    "",
                    RegexOptions.IgnoreCase);


            WichtigeInformationenHtml =
                html;
        }


        // =====================================================
        // PRIVATE BILDER
        // =====================================================

        LoadPrivateBilder();

        StartPrivateBildTimer();


        // =====================================================
        // SPONSOREN
        // =====================================================

        LoadSponsors();

        StartSponsorTimer();
    }


    // =========================================================
    // PRIVATE BILDER LADEN
    // =========================================================

    private void LoadPrivateBilder()
    {
        var bilderOrdner =
            Path.Combine(
                Env.WebRootPath,
                "Impressionen_Bilder");


        if (!Directory.Exists(bilderOrdner))
        {
            return;
        }


        var erlaubteEndungen =
            new[]
            {
                ".jpg",
                ".jpeg",
                ".png",
                ".webp",
                ".gif"
                };


        PrivateBilder =
            Directory
                .GetFiles(bilderOrdner)

                .Where(file =>
                    erlaubteEndungen.Contains(
                        Path.GetExtension(file),
                        StringComparer.OrdinalIgnoreCase))

                .Select(file =>
                    "/Impressionen_Bilder/" +
                    Uri.EscapeDataString(
                        Path.GetFileName(file)))

                .ToList();


        // Erstes Bild zufällig auswählen
        if (PrivateBilder.Count > 0)
        {
            privateBildIndex =
                Random.Shared.Next(
                    PrivateBilder.Count);
        }
    }


    // =========================================================
    // PRIVATE BILDER TIMER
    // =========================================================

    private void StartPrivateBildTimer()
    {
        if (PrivateBilder.Count <= 1)
        {
            return;
        }


        privateBildTimer =
            new System.Timers.Timer(
                10_000);


        privateBildTimer.Elapsed +=
            async (_, _) =>
            {
                var neuerIndex =
                    privateBildIndex;


                // Sicherstellen, dass nicht zweimal
                // hintereinander dasselbe Bild erscheint
                while (neuerIndex ==
                       privateBildIndex)
                {
                    neuerIndex =
                        Random.Shared.Next(
                            PrivateBilder.Count);
                }


                privateBildIndex =
                    neuerIndex;


                await InvokeAsync(
                    StateHasChanged);
            };


        privateBildTimer.AutoReset =
            true;

        privateBildTimer.Start();
    }


    // =========================================================
    // EVENT BESCHREIBUNG KÜRZEN
    // =========================================================

    private string GetShortDescription(
        string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return "";
        }


        var cleanDescription =
            Regex.Replace(
                description,
                @"\s+",
                " ")
            .Trim();


        const int maxLength = 180;


        if (cleanDescription.Length <= maxLength)
        {
            return cleanDescription;
        }


        var shortened =
            cleanDescription.Substring(
                0,
                maxLength);


        var lastSpace =
            shortened.LastIndexOf(' ');


        if (lastSpace > 0)
        {
            shortened =
                shortened.Substring(
                    0,
                    lastSpace);
        }


        return shortened.Trim()
               + "...";
    }


    // =========================================================
    // BILD URL
    // =========================================================

    private string GetImageUrl(
        string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return "";
        }


        if (imageUrl.StartsWith("/"))
        {
            return imageUrl;
        }


        return "/" + imageUrl;
    }


    // =========================================================
    // DOC ITEM
    // =========================================================

    private class DocItem
    {
        public string Title { get; set; } = "";

        public string Html { get; set; } = "";
    }


    // =========================================================
    // SPONSOREN LADEN
    // =========================================================

    private void LoadSponsors()
    {
        var sponsorDatei =
            Path.Combine(
                Env.WebRootPath,
                "configsheets/Informationen",
                "Sponsoren.docx");


        if (!File.Exists(sponsorDatei))
        {
            return;
        }


        var html =
            DocxService.ConvertToHtml(
                sponsorDatei);


        // CSS- und Script-Bereiche vollständig entfernen

        html =
            Regex.Replace(
                html,
                @"<style[^>]*>.*?</style>",
                "",
                RegexOptions.IgnoreCase |
                RegexOptions.Singleline);


        html =
            Regex.Replace(
                html,
                @"<script[^>]*>.*?</script>",
                "",
                RegexOptions.IgnoreCase |
                RegexOptions.Singleline);


        // Absätze und Zeilenumbrüche in echte
        // Zeilenumbrüche umwandeln

        html =
            Regex.Replace(
                html,
                @"</?(p|div|li|br)[^>]*>",
                "\n",
                RegexOptions.IgnoreCase);


        // Alle übrigen HTML-Tags entfernen

        var text =
            Regex.Replace(
                html,
                @"<[^>]+>",
                "");


        // HTML-Zeichen wie &amp; zurückwandeln

        text =
            System.Net.WebUtility.HtmlDecode(
                text);


        Sponsoren =
            text

                .Split(
                    new[] { '\r', '\n' },
                    StringSplitOptions.RemoveEmptyEntries)

                .Select(x =>
                    x.Trim())

                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))

                .Where(x =>
                    !x.Equals(
                        "doc",
                        StringComparison.OrdinalIgnoreCase))

                .Distinct()

                .ToList();


        if (Sponsoren.Count > 0)
        {
            sponsorIndex =
                Random.Shared.Next(
                    Sponsoren.Count);
        }
    }


    // =========================================================
    // SPONSOREN TIMER
    // =========================================================

    private void StartSponsorTimer()
    {
        if (Sponsoren.Count <= 1)
        {
            return;
        }


        sponsorTimer =
            new System.Timers.Timer(
                10_000);


        sponsorTimer.Elapsed +=
            async (_, _) =>
            {
                var neuerIndex =
                    sponsorIndex;


                // Wenn mehrere Sponsoren vorhanden sind,
                // nicht zweimal denselben hintereinander anzeigen
                while (neuerIndex ==
                       sponsorIndex)
                {
                    neuerIndex =
                        Random.Shared.Next(
                            Sponsoren.Count);
                }


                sponsorIndex =
                    neuerIndex;


                await InvokeAsync(
                    StateHasChanged);
            };


        sponsorTimer.AutoReset =
            true;

        sponsorTimer.Start();
    }


    // =========================================================
    // DISPOSE
    // =========================================================

    public void Dispose()
    {
        privateBildTimer?.Stop();

        privateBildTimer?.Dispose();


        sponsorTimer?.Stop();

        sponsorTimer?.Dispose();
    }
}
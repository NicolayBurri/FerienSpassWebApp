@page "/"

@implements IDisposable

@using FerienspassWebApp.Services
@using System.Text.RegularExpressions
@using FerienspassWebApp.Models
@using FerienspassWebApp.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using System.Timers

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DocxService DocxService
@inject IWebHostEnvironment Env

<PageTitle>FerienSpass</PageTitle>


<div class="homepage-container">

    @* =========================================================
    TITELBILD
    ========================================================= *@

    <section class="homepage-hero">

        <div class="homepage-hero-text">

            <h1>
                Willkommen beim FerienSpass
            </h1>

            <p>
                Spiel, Spass und unvergessliche Erlebnisse
                während der Ferien!
            </p>

        </div>

    </section>


    @* =========================================================
    BILDER AUS PRIVATEFILES/BILDER
    ========================================================= *@

    @if (PrivateBilder.Count > 0)
    {
        <section class="private-picture-section">

            <h3> Impressionen FerienSpass @DateTime.Now.Year</h3>
            <div class="private-picture-thanks">
                Herzlichen Dank für die vielen schönen
                FerienSpass-Momente!
            </div>

            <div class="private-picture-container">

                <img src="@AktuellesPrivatBild"
                     class="private-picture"
                     alt="FerienSpass Impression" />

            </div>

        </section>
    }


    @* =========================================================
    ABGESAGTE EVENTS
    ========================================================= *@

    @if (cancelledEvents.Any())
    {
        <div class="cancelled-events-box">

            <div class="cancelled-events-title">
                Abgesagte Events
            </div>

            <ul class="cancelled-events-list">

                @foreach (var cancelledEvent in cancelledEvents)
                {
                    <li>
                        @cancelledEvent.Eventname
                    </li>
                }

            </ul>

        </div>
    }


    @* =========================================================
    3 ZUFÄLLIGE EVENTS
    ========================================================= *@

    @if (featuredEvents.Any())
    {
        <section class="featured-events-section">

            <h2 class="featured-events-heading">
                Events entdecken
            </h2>

            <div class="row g-4">

                @foreach (var featuredEvent in featuredEvents)
                {
                    <div class="col-12 col-md-6 col-lg-4">

                        <div class="card featured-event-card h-100">

                            @if (!string.IsNullOrWhiteSpace(
                           featuredEvent.BildUrl))
                            {
                                <div class="featured-event-image-container">

                                    <img src="@GetImageUrl(featuredEvent.BildUrl)"
                                         class="featured-event-image"
                                         alt="Bild zu @featuredEvent.Eventname" />

                                </div>
                            }
                            else
                            {
                                <div class="featured-event-no-image">

                                    <span>
                                        FerienSpass
                                    </span>

                                </div>
                            }


                            <div class="card-body featured-event-body">

                                <h3 class="featured-event-title">
                                    @featuredEvent.Eventname
                                </h3>


                                @if (featuredEvent.StartZeit.HasValue)
                                {
                                    <div class="featured-event-date">

                                        <strong>
                                            Datum:
                                        </strong>

                                        @featuredEvent.StartZeit.Value.ToString("dd.MM.yyyy")

                                        <span>
                                            um
                                            @featuredEvent.StartZeit.Value.ToString("HH:mm")
                                            Uhr
                                        </span>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(
                               featuredEvent.Beschreibung))
                                {
                                    <p class="featured-event-description">

                                        @GetShortDescription(
                                                 featuredEvent.Beschreibung)

                                    </p>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>

        </section>
    }


    @* =========================================================
    BESTEHENDE INFORMATIONEN
    ========================================================= *@

    @if (Documents.Count == 0)
    {
        <p>
            Es sind noch keine Informationen vorhanden.
            Wir freuen uns, Sie bald mit aktuellen Informationen
            beliefern zu dürfen. Mit den besten Grüssen Ihr
            FerienSpass Team.
        </p>
    }
    else
    {


        @* =====================================================
    WICHTIGE INFORMATIONEN
    ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(
       WichtigeInformationenHtml))
        {
            <br />

            <div style="
                position:relative;
                background:silver;
                border:1px solid #ccc;
                border-radius:8px;
                padding:20px;
                margin-bottom:20px;">

                <div style="
                    position:absolute;
                    top:-12px;
                    left:-12px;
                    width:30px;
                    height:30px;
                    border-radius:50%;
                    background:red;
                    color:white;
                    font-weight:bold;
                    display:flex;
                    justify-content:center;
                    align-items:center;
                    border:2px solid white;">

                    i

                </div>


                <div style="
                    color:red;
                    font-size:1.15rem;
                    font-weight:bold;
                    line-height:2;
                    margin-bottom:1px;">

                    @((MarkupString)WichtigeInformationenHtml)

                </div>

            </div>
        }


        <br />


        @* =====================================================
    ANMELDEINFORMATIONEN
    ===================================================== *@

        <div style="
            position:relative;
            background:#f2f2f2;
            border:1px solid #ccc;
            border-radius:8px;
            padding:20px;
            margin-bottom:20px;">

            <div style="
                position:absolute;
                top:-12px;
                left:-12px;
                width:30px;
                height:30px;
                border-radius:50%;
                background:blue;
                color:white;
                font-weight:bold;
                display:flex;
                justify-content:center;
                align-items:center;
                border:2px solid white;">

                i

            </div>


            @if (settings != null)
            {
                <h3 style="color:red">
                    20. FERIENSPASS 21.-25. September 2026:
                </h3>


                @if (isKursleiter)
                {
                    <h4>
                        Anmeldungen ab:
                        @settings.KursleiterStart?.ToString("dd.MM.yyyy HH:mm")
                    </h4>

                    <h4>
                        Anmeldeschluss:
                        @settings.KursleiterEnde?.ToString("dd.MM.yyyy HH:mm")
                    </h4>
                }
                else
                {
                    <h4>
                        Anmeldungen ab:
                        @settings.AnmeldungStart?.ToString("dd.MM.yyyy HH:mm")
                    </h4>

                    <h4>
                        Anmeldeschluss:
                        @settings.AnmeldungEnde?.ToString("dd.MM.yyyy HH:mm")
                    </h4>
                }


                <h4 style="color:darkred">
                    Bezahlungen müssen bis am Freitag,
                    dem 11. September 2026 beglichen werden.
                </h4>
            }

        </div>


        <br />


        @* =====================================================
    SPONSOREN
    ===================================================== *@

        <h3>
            Wir danken unseren Sponsoren und HelferInnen ganz
            herzlich für ihre finanzielle, materielle oder
            persönliche Unterstützung. Nur dank ihrer Hilfe ist
            es uns möglich, den Kindern spannende und
            erschwingliche Kurse anzubieten!
        </h3>


        <br />


        <div style="
            margin-top:40px;
            padding:15px;
            text-align:center;
            background:lightgreen;
            border-radius:8px;
            font-size:1.3rem;
            font-weight:bold;
            color:darkgreen;">

            Ein herzliches Dankeschön an unsere Hauptsponsoren:

            <br />
            <br />

            Einwohnergemeinde Rohrbach, 4938 Rohrbach

            <br />

            Einwohnergemeinde Auswil, 4944 Auswil

            <br />

            Einwohnergemeinde Rohrbachgraben,
            4938 Rohrbachgraben

        </div>


        @if (!string.IsNullOrWhiteSpace(
       AktuellerSponsor))
        {
            <div style="
                margin-top:40px;
                padding:15px;
                text-align:center;
                background:#f2f2f2;
                border-radius:8px;
                font-size:1.3rem;
                font-weight:bold;
                color:green;">

                Ein weiterer Dank geht an:
                @AktuellerSponsor

            </div>
        }


        @if (Sponsoren.Count > 0)
        {
            <details style="
                margin-top:20px;
                background:#f2f2f2;
                border-radius:8px;
                padding:15px;
                text-align:center;">

                <summary style="
                    cursor:pointer;
                    font-size:1.2rem;
                    font-weight:bold;
                    color:black;
                    user-select:none;">

                    Alle Sponsoren einsehen

                </summary>


                <div style="
                    margin-top:15px;
                    font-size:1.1rem;
                    line-height:1.8;">

                    @foreach (var sponsor in Sponsoren)
                    {
                        <div>
                            @sponsor
                        </div>
                    }

                </div>

            </details>
        }
    }

</div>



@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Identity
@using FerienspassWebApp.Models
@inject UserManager<ApplicationUser> UserManager

<h3>Admin - Benutzerverwaltung</h3>

@if (users == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Rollen</th>
                <th>Aktionen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in pagedUsers)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", userRoles.ContainsKey(user.Id)
                        ? userRoles[user.Id]
                        : new List<string>())
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary"
                                @onclick="() => MakeAdmin(user)">
                            Admin
                        </button>

                        <button class="btn btn-sm btn-secondary"
                                @onclick="() => MakeInstructor(user)">
                            Kursleiter
                        </button>

                        <button class="btn btn-sm btn-warning"
                                @onclick="() => MakeParent(user)">
                            Eltern
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalPages > 1)
    {
        <div class="mt-3">

            <button class="btn btn-secondary"
                    @onclick="PreviousPage"
                    disabled="@(currentPage == 1)">
                ← Zurück
            </button>

            @for (int i = 1; i <= totalPages; i++)
            {
                var pagenumber = i;

                <button class="btn @(pagenumber == currentPage ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => GoToPage(pagenumber)">
                    @pagenumber
                </button>
            }

            <button class="btn btn-secondary"
                    @onclick="NextPage"
                    disabled="@(currentPage == totalPages)">
                Weiter →
            </button>

        </div>
    }
}

@code {
    List<ApplicationUser>? users;
    Dictionary<string, IList<string>> userRoles = new();
    private int currentPage = 1;
    private const int pageSize = 20;

    private List<ApplicationUser> pagedUsers =>
        users?
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList()
        ?? new();

    private int totalPages =>
        users == null
            ? 0
            : (int)Math.Ceiling(users.Count / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        users = UserManager.Users
            .OrderBy(x => x.Email)
            .ToList();

        foreach (var user in users)
        {
            userRoles[user.Id] = await UserManager.GetRolesAsync(user);
        }

        if (currentPage > totalPages)
            currentPage = totalPages == 0 ? 1 : totalPages;
    }

    async Task MakeAdmin(ApplicationUser user)
    {
        await SetRole(user, "Admin");
    }

    async Task MakeParent(ApplicationUser user)
    {
        await SetRole(user, "Eltern");
    }

    async Task MakeInstructor(ApplicationUser user)
    {
        await SetRole(user, "Kursleiter");
    }

    async Task SetRole(ApplicationUser user, string role)
    {
        var roles = await UserManager.GetRolesAsync(user);

        foreach (var r in roles)
        {
            await UserManager.RemoveFromRoleAsync(user, r);
        }

        await UserManager.AddToRoleAsync(user, role);

        await OnInitializedAsync();
    }

    void GoToPage(int page)
    {
        currentPage = page;
    }

    void NextPage()
    {
        if (currentPage < totalPages)
            currentPage++;
    }

    void PreviousPage()
    {
        if (currentPage > 1)
            currentPage--;
    }
}
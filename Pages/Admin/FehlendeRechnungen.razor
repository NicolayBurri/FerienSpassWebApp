@page "/admin/fehlende-rechnungen"

@using Microsoft.EntityFrameworkCore
@using FerienspassWebApp.Data
@using FerienspassWebApp.Models
@using Microsoft.AspNetCore.Authorization
@using System.Text

@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<h3>Kinder ohne erstellte Rechnung</h3>

@if (isLoading)
{
    <p>Laden...</p>
}
else if (!items.Any())
{
    <p>Alle Rechnungen wurden generiert.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Account</th>
                <th>Kinder / Kurse</th>
                <th>Gesamt</th>
                <th>Email</th>
                <th>Aktionen</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>
                        @item.ParentUser.Vorname @item.ParentUser.Nachname
                    </td>

                    <td>
                        @foreach (var enrollment in item.Enrollments)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3 gap-1">
                                <div>
                                    <strong>@enrollment.Child.Name</strong><br />
                                    @enrollment.Event.Eventname – CHF @enrollment.Event.price
                                </div>

                                <button class="btn btn-danger btn-sm flex-shrink-0"
                                        @onclick="() => RemoveChildFromCourse(item, enrollment)">
                                    Kind aus Kurs löschen
                                </button>
                            </div>
                        }
                    </td>

                    <td>
                        <strong>
                            CHF @item.Enrollments.Sum(x => x.Event.price)
                        </strong>
                    </td>

                    <td>
                        @item.ParentUser.Email
                    </td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@CreateMailLink(item)">
                            Email generieren
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool isLoading = true;
    private List<ParentInvoiceGroup> items = new();

    protected override async Task OnInitializedAsync()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();

        var eventChildren = await Db.EventChildren
            .Include(x => x.Child)
                .ThenInclude(x => x.ParentUser)
            .Include(x => x.Event)
            .Where(x =>
                x.Status == EnrollmentStatus.Confirmed &&
                !x.IsInvoiced)
            .ToListAsync();

        items = eventChildren
            .Where(x => x.Child.ParentUser != null)
            .GroupBy(x => x.Child.ParentUser!.Id)
            .Select(g => new ParentInvoiceGroup
                {
                    ParentUser = g.First().Child.ParentUser!,
                    Enrollments = g.ToList()
                })
            .ToList();

        isLoading = false;
    }

    private string CreateMailLink(ParentInvoiceGroup item)
    {
        var recipient = item.ParentUser.Email ?? "";
        var subject = Uri.EscapeDataString(
            "Bitte Rechnung für FerienSpass erstellen");

        var text = new StringBuilder();

        text.AppendLine("Bitte die Rechnung für folgende Anmeldungen erstellen:");
        text.AppendLine();

        foreach (var enrollment in item.Enrollments)
        {
            text.AppendLine(
                $"{enrollment.Child.Name} {item.ParentUser.Nachname}");
            text.AppendLine(
                $"Kurs: {enrollment.Event.Eventname}");
            text.AppendLine(
                $"Betrag: CHF {enrollment.Event.price}");
            text.AppendLine();
        }

        var total = item.Enrollments.Sum(x => x.Event.price);

        text.AppendLine($"Gesamtbetrag: CHF {total}");

        var body = Uri.EscapeDataString(text.ToString());

        return $"mailto:{recipient}?subject={subject}&body={body}";
    }

    private class ParentInvoiceGroup
    {
        public ApplicationUser ParentUser { get; set; } = default!;
        public List<EventChild> Enrollments { get; set; } = new();
    }

    private async Task RemoveChildFromCourse(
    ParentInvoiceGroup group,
    EventChild enrollment)
    {
        await using var Db = await DbFactory.CreateDbContextAsync();

        var entity = await Db.EventChildren
            .FirstOrDefaultAsync(x => x.Id == enrollment.Id);

        if (entity == null)
            return;

        Db.EventChildren.Remove(entity);
        await Db.SaveChangesAsync();

        group.Enrollments.Remove(enrollment);

        // Falls der Account keine offenen Kurse mehr hat,
        // verschwindet die ganze Zeile.
        if (!group.Enrollments.Any())
        {
            items.Remove(group);
        }
    }
}
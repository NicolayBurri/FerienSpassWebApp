    private static string RecipientRoleText(
        EventMailRecipient recipient)
    {
        var parts = new List<string>();

        if (recipient.IsParent)
            parts.Add("Eltern / Erziehungsberechtigte");

        if (recipient.IsDriver)
            parts.Add(
                $"Fahrer/in ({recipient.Seats} Sitzplätze)");

        if (recipient.IsHelper)
            parts.Add("Betreuungsperson");

        return parts.Any()
            ? string.Join(", ", parts)
            : "Teilnehmende Person";
    }



@page "/kursleiter/events/{eventId:int}"

@using FerienspassWebApp.Data
@using FerienspassWebApp.Models
@using Microsoft.EntityFrameworkCore
@using ClosedXML.Excel
@using System.IO
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using System.Net
@using System.Net.Mail
@using System.Text

@attribute [Authorize(Roles = "Admin,Kursleiter")]

@inject IJSRuntime JS
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IConfiguration Configuration

<h1>Event Details</h1>

<br />

@if (ev == null)
{
    <p>Lade...</p>
}
else
{
    <h2>@ev.Eventname</h2>

    @if (canSendEventMail)
    {
        <div style="margin:15px 0 25px 0;">
            <button class="btn @(HasEnoughChildren ? "btn-success" : "btn-danger")"
                    @onclick="ProcessEventEmails"
                    disabled="@isSendingEventMail">

                @if (isSendingEventMail)
                {
                    <span>E-Mails werden versendet...</span>
                }
                else if (HasEnoughChildren)
                {
                    <span>📧 Bestätigungsmails senden</span>
                }
                else
                {
                    <span>📧 Absagemails senden</span>
                }
            </button>

            @if (!string.IsNullOrWhiteSpace(eventMailMessage))
            {
                <div style="margin-top:10px;">
                    <b>@eventMailMessage</b>
                </div>
            }

            @if (!HasEnoughChildren)
            {
                <div style="margin-top:8px; color:darkred;">
                    Mindestanzahl: @MinimumChildren |
                    Bestätigt: @ConfirmedChildrenCount
                </div>
            }
        </div>
    }

    <br />

    <h3>Datum und Zeit</h3>

    <p>
        @ev.StartZeit?.ToString("dd.MM.yyyy HH:mm")
        -
        @ev.EndeZeit?.ToString("dd.MM.yyyy HH:mm")
    </p>

    <br />

    <h3>Veranstaltungsort</h3>

    <p>@ev.Location</p>

    <br />

    <h4>Kursleiter</h4>

    @if (ev.Kursleiter?.Any() == true)
    {
        @foreach (var kl in ev.Kursleiter)
        {
            <p>
                @kl.User?.Vorname @kl.User?.Nachname
                -> Telefonnummer: @kl.User?.Telefonnummer
            </p>
        }
    }
    else
    {
        <p style="color:red;">
            Es wurde noch kein Kursleiter bestimmt.
        </p>
    }

    <hr />

    <h4>Anmeldungen</h4>

    <span>Bestätigt: @GetCount(ev.Id, EnrollmentStatus.Confirmed)</span>
    <br />
    <span>Warteliste: @GetCount(ev.Id, EnrollmentStatus.WaitingList)</span>
    <br />
    <br />


    @if (registrations.Any())
    {
        @foreach (var entry in registrations)
        {
            <div style="border:1px solid #ddd; padding:10px; margin-bottom:8px;">

                <b>Kind:</b>
                @entry.Child.Name @entry.Child.ParentUser?.Nachname
                <br />

                <span>Alter: @entry.Child.Alter</span>
                <br />

                <span>Klasse: @entry.Child.Klasse</span>
                <br />

                <span style="color:@GetColor(entry.Status)">
                    @GetStatusText(entry.Status)
                </span>

                <hr />

                <b>Notfallkontakte (Eltern):</b>

                @if (contactsByParent.TryGetValue(
               entry.Child.ParentUserId,
               out var contacts))
                {
                    @foreach (var c in contacts)
                    {
                        <div style="margin-left:10px;">
                            @c.Name - @c.Telefon (@c.Beziehung)
                        </div>
                    }
                }
                else
                {
                    <div style="margin-left:10px; color:gray;">
                        Keine Kontakte vorhanden
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p>Für diesen Event sind noch keine Kinder angemeldet.</p>
    }

    <hr />

    @* =========================================================
       FAHRER
       ========================================================= *@

    <h4>Fahrer</h4>

    @if (ev.BrauchtFahrer)
    {
        <p>
            Benötigte Sitzplätze: <b>@requiredSeats</b> |
            Vorhandene Sitzplätze: <b>@availableSeats</b> |
            Fehlende Sitzplätze:
            <b style="color:@(missingSeats > 0 ? "red" : "green")">
                @missingSeats
            </b>
        </p>

        @if (roles.Any(x => x.Role == RoleType.Driver))
        {
            <h5>Vorhandene Fahrer</h5>

            @foreach (var driver in roles.Where(x => x.Role == RoleType.Driver))
            {
                <div style="
                    border:1px solid #ddd;
                    padding:10px;
                    margin-bottom:8px;
                    border-radius:5px;">

                    <b>
                        @driver.User?.Vorname
                        @driver.User?.Nachname
                    </b>
                    <br />

                    Sitzplätze: @(driver.Seats ?? 0)
                    <br />

                    Telefonnummer:
                    @(driver.User?.Telefonnummer ?? "-")
                    <br />

                    E-Mail:
                    @(driver.User?.Email ?? "-")
                    <br />

                    Ort:
                    @(driver.User?.Ort ?? "-")
                </div>
            }
        }
        else
        {
            <p>Es hat sich noch kein Fahrer angemeldet.</p>
        }

        <div style="
            margin-top:20px;
            border-top:1px solid #ddd;
            padding-top:15px;">

            <h5>Fahrer manuell hinzufügen</h5>

            <div style="
                display:flex;
                gap:8px;
                margin-bottom:10px;
                flex-wrap:wrap;">

                <input class="form-control"
                       style="max-width:350px;"
                       placeholder="Vorname, Nachname oder Wohnort"
                       @bind="driverSearch"
                       @bind:event="oninput" />

                <button class="btn btn-primary"
                        @onclick="SearchDrivers">
                    Suchen
                </button>
            </div>

            @if (driverSearchPerformed &&
           !driverSearchResults.Any())
            {
                <p style="color:gray;">
                    Keine Benutzer gefunden.
                </p>
            }

            @foreach (var user in driverSearchResults)
            {
                <div style="
                    border:1px solid #ccc;
                    padding:10px;
                    margin-bottom:8px;
                    border-radius:5px;">

                    <b>@user.Vorname @user.Nachname</b>
                    <br />

                    <span>
                        Ort: @(user.Ort ?? "-")
                    </span>
                    <br />

                    <span>
                        E-Mail: @(user.Email ?? "-")
                    </span>
                    <br />

                    <span>
                        Telefon: @(user.Telefonnummer ?? "-")
                    </span>

                    <br />
                    <br />

                    <label>
                        Sitzplätze:
                    </label>

                    <input type="number"
                           min="1"
                           style="width:80px; margin-left:5px;"
                           @bind="user.Seats" />

                    <button class="btn btn-success"
                            style="margin-left:10px;"
                            @onclick="() => AddDriver(user)">
                        Als Fahrer hinzufügen
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <p>
            Es werden für diesen Event keine Fahrer benötigt.
        </p>
    }

    <hr />

    @* =========================================================
       BETREUUNGSPERSONEN
       ========================================================= *@

    <h4>Betreuungspersonen</h4>

    @if (ev.BrauchtBetreuung)
    {
        <p>
            Benötigt: <b>@requiredHelper</b> |
            Vorhanden: <b>@HelperCount</b> |
            Fehlen:
            <b style="color:@(missingHelper > 0 ? "red" : "green")">
                @missingHelper
            </b>
        </p>

        @if (roles.Any(x => x.Role == RoleType.Helper))
        {
            <h5>Vorhandene Betreuungspersonen</h5>

            @foreach (var helper in roles.Where(x => x.Role == RoleType.Helper))
            {
                <div style="
                    border:1px solid #ddd;
                    padding:10px;
                    margin-bottom:8px;
                    border-radius:5px;">

                    <b>
                        @(helper.User?.Vorname)
                        @(helper.User?.Nachname)
                    </b>
                    <br />

                    Telefonnummer:
                    @(helper.User?.Telefonnummer ?? "-")
                    <br />

                    E-Mail:
                    @(helper.User?.Email ?? "-")
                    <br />

                    Ort:
                    @(helper.User?.Ort ?? "-")
                </div>
            }
        }
        else
        {
            <p>
                Es hat sich noch niemand als Betreuungsperson eingetragen.
            </p>
        }

        <div style="
            margin-top:20px;
            border-top:1px solid #ddd;
            padding-top:15px;">

            <h5>Betreuungsperson manuell hinzufügen</h5>

            <div style="
                display:flex;
                gap:8px;
                margin-bottom:10px;
                flex-wrap:wrap;">

                <input class="form-control"
                       style="max-width:350px;"
                       placeholder="Vorname, Nachname oder Wohnort"
                       @bind="helperSearch"
                       @bind:event="oninput" />

                <button class="btn btn-primary"
                        @onclick="SearchHelpers">
                    Suchen
                </button>
            </div>

            @if (helperSearchPerformed &&
           !helperSearchResults.Any())
            {
                <p style="color:gray;">
                    Keine Benutzer gefunden.
                </p>
            }

            @foreach (var user in helperSearchResults)
            {
                <div style="
                    border:1px solid #ccc;
                    padding:10px;
                    margin-bottom:8px;
                    border-radius:5px;">

                    <b>@user.Vorname @user.Nachname</b>
                    <br />

                    <span>
                        Ort: @(user.Ort ?? "-")
                    </span>
                    <br />

                    <span>
                        E-Mail: @(user.Email ?? "-")
                    </span>
                    <br />

                    <span>
                        Telefon: @(user.Telefonnummer ?? "-")
                    </span>

                    <br />
                    <br />

                    <button class="btn btn-success"
                            @onclick="() => AddHelper(user)">
                        Als Betreuungsperson hinzufügen
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <p>
            Es werden für diesen Event keine Betreuungspersonen benötigt.
        </p>
    }

    @* =========================================================
       MAIL BEI FEHLENDEN FAHRERN / HELFERN
       ========================================================= *@

    @if (missingSeats > 0 || missingHelper > 0)
    {
        <hr />

        <h4>Fahrer / Betreuungspersonen suchen</h4>

        <p style="color:darkred;">
            Für diesen Event werden noch Personen benötigt.
        </p>

        @if (missingSeats > 0)
        {
            <p>
                Es fehlen noch
                <b>@missingSeats Sitzplätze</b>.
            </p>
        }

        @if (missingHelper > 0)
        {
            <p>
                Es fehlen noch
                <b>@missingHelper Betreuungspersonen</b>.
            </p>
        }

        <button class="btn btn-warning"
                @onclick="OpenRecruitmentMail">
            Eltern per E-Mail anfragen
        </button>
    }

    <hr />

    <button class="btn btn-secondary"
            @onclick="ExportExcel">
        Excel exportieren
    </button>
}


@code {

    [Parameter]
    public int eventId { get; set; }


    // =========================================================
    // FAHRER / SITZPLÄTZE
    // =========================================================

    int availableSeats =>
    roles
    .Where(x => x.Role == RoleType.Driver)
    .Sum(x => x.Seats ?? 0);

    int requiredSeats =>
    ev?.AnzahlSitzplaetze ?? 0;

    int missingSeats =>
    ev?.BrauchtFahrer == true
    ? Math.Max(requiredSeats - availableSeats, 0)
    : 0;


    // =========================================================
    // BETREUUNG
    // =========================================================

    int HelperCount =>
    roles.Count(x => x.Role == RoleType.Helper);

    int requiredHelper =>
    ev?.AnzahlBetreuung ?? 0;

    int missingHelper =>
    ev?.BrauchtBetreuung == true
    ? Math.Max(requiredHelper - HelperCount, 0)
    : 0;


    // =========================================================
    // SUCHEN
    // =========================================================

    private string driverSearch = "";
    private bool driverSearchPerformed = false;

    private List<UserSearchResult> driverSearchResults = new();


    private string helperSearch = "";
    private bool helperSearchPerformed = false;

    private List<UserSearchResult> helperSearchResults = new();


    // =========================================================
    // DATEN
    // =========================================================

    private Event? ev;

    private List<EventRoleAssignment> roles = new();

    private List<EventChild> registrations = new();

    private Dictionary<string, List<EmergencyContact>>
        contactsByParent = new();

    private SystemSettings? systemSettings;

    private bool isSendingEventMail = false;
    private string? eventMailMessage;

    private int MinimumChildren => ev?.MinKinder ?? 0;

    private int ConfirmedChildrenCount =>
        registrations.Count(x => x.Status == EnrollmentStatus.Confirmed);

    private bool HasEnoughChildren =>
        ConfirmedChildrenCount >= MinimumChildren;

    private bool canSendEventMail =>
        systemSettings?.AnmeldungEnde.HasValue == true &&
        DateTime.Now > systemSettings.AnmeldungEnde.Value;


    // =========================================================
    // USER SEARCH DTO
    // =========================================================

    private class UserSearchResult
    {
        public string Id { get; set; } = "";

        public string? Vorname { get; set; }

        public string? Nachname { get; set; }

        public string? Ort { get; set; }

        public string? Email { get; set; }

        public string? Telefonnummer { get; set; }

        public int Seats { get; set; } = 1;
    }


    // =========================================================
    // EVENT LADEN
    // =========================================================

    protected override async Task OnParametersSetAsync()
    {
        await LoadEventData();
    }


    private async Task LoadEventData()
    {
        await using var Db =
            await DbFactory.CreateDbContextAsync();

        systemSettings = await Db.SystemSettings
            .AsNoTracking()
            .FirstOrDefaultAsync();

        ev = await Db.Events
            .Include(x => x.Kursleiter)
                .ThenInclude(x => x.User)
            .FirstOrDefaultAsync(x => x.Id == eventId);

        registrations = await Db.EventChildren
            .Include(x => x.Child)
                .ThenInclude(c => c.ParentUser)
            .Where(x => x.EventId == eventId)
            .OrderBy(x => x.RegisteredAt)
            .ToListAsync();


        var parentIds = registrations
            .Select(x => x.Child.ParentUserId)
            .Distinct()
            .ToList();


        var contacts = await Db.EmergencyContacts
            .Where(x =>
                parentIds.Contains(x.ApplicationUserId))
            .ToListAsync();


        contactsByParent = contacts
            .GroupBy(x => x.ApplicationUserId)
            .ToDictionary(
                g => g.Key,
                g => g.ToList());


        roles = await Db.EventRoleAssignments
            .Include(x => x.User)
            .Where(x => x.EventId == eventId)
            .ToListAsync();
    }


    // =========================================================
    // STATUS
    // =========================================================

    string GetColor(EnrollmentStatus status)
        => status == EnrollmentStatus.Confirmed
            ? "green"
            : "orange";


    string GetStatusText(EnrollmentStatus status)
        => status switch
        {
            EnrollmentStatus.Confirmed => "Bestätigt",
            EnrollmentStatus.WaitingList => "Warteliste",
            _ => status.ToString()
        };


    // =========================================================
    // BENUTZER SUCHEN
    // =========================================================

    private async Task<List<UserSearchResult>>
        SearchUsersInternal(string search)
    {
        if (string.IsNullOrWhiteSpace(search))
            return new List<UserSearchResult>();

        search = search.Trim();

        await using var Db =
            await DbFactory.CreateDbContextAsync();

        return await Db.Users
            .AsNoTracking()
            .Where(x =>
                (x.Vorname != null &&
                 x.Vorname.Contains(search)) ||

                (x.Nachname != null &&
                 x.Nachname.Contains(search)) ||

                (x.Ort != null &&
                 x.Ort.Contains(search)))
            .OrderBy(x => x.Nachname)
            .ThenBy(x => x.Vorname)
            .Take(30)
            .Select(x => new UserSearchResult
                {
                    Id = x.Id,
                    Vorname = x.Vorname,
                    Nachname = x.Nachname,
                    Ort = x.Ort,
                    Email = x.Email,
                    Telefonnummer = x.Telefonnummer,
                    Seats = 1
                })
            .ToListAsync();
    }


    async Task SearchDrivers()
    {
        driverSearchPerformed = true;

        driverSearchResults =
            await SearchUsersInternal(driverSearch);
    }


    async Task SearchHelpers()
    {
        helperSearchPerformed = true;

        helperSearchResults =
            await SearchUsersInternal(helperSearch);
    }


    // =========================================================
    // FAHRER HINZUFÜGEN
    // =========================================================

    async Task AddDriver(UserSearchResult user)
    {
        if (user.Seats < 1)
            user.Seats = 1;

        await using var Db =
            await DbFactory.CreateDbContextAsync();


        var alreadyAssigned =
            await Db.EventRoleAssignments
                .AnyAsync(x =>
                    x.EventId == eventId &&
                    x.UserId == user.Id &&
                    x.Role == RoleType.Driver);


        if (alreadyAssigned)
        {
            driverSearchResults.Remove(user);
            return;
        }


        var assignment = new EventRoleAssignment
            {
                EventId = eventId,
                UserId = user.Id,
                Role = RoleType.Driver,
                Seats = user.Seats
            };


        Db.EventRoleAssignments.Add(assignment);

        await Db.SaveChangesAsync();


        roles = await Db.EventRoleAssignments
            .Include(x => x.User)
            .Where(x => x.EventId == eventId)
            .ToListAsync();


        driverSearchResults.Remove(user);

        StateHasChanged();
    }


    // =========================================================
    // BETREUUNGSPERSON HINZUFÜGEN
    // =========================================================

    async Task AddHelper(UserSearchResult user)
    {
        await using var Db =
            await DbFactory.CreateDbContextAsync();


        var alreadyAssigned =
            await Db.EventRoleAssignments
                .AnyAsync(x =>
                    x.EventId == eventId &&
                    x.UserId == user.Id &&
                    x.Role == RoleType.Helper);


        if (alreadyAssigned)
        {
            helperSearchResults.Remove(user);
            return;
        }


        var assignment = new EventRoleAssignment
            {
                EventId = eventId,
                UserId = user.Id,
                Role = RoleType.Helper
            };


        Db.EventRoleAssignments.Add(assignment);

        await Db.SaveChangesAsync();


        roles = await Db.EventRoleAssignments
            .Include(x => x.User)
            .Where(x => x.EventId == eventId)
            .ToListAsync();


        helperSearchResults.Remove(user);

        StateHasChanged();
    }


    // =========================================================
    // BESTÄTIGUNG / ABSAGE PER SMTP
    // =========================================================

    private sealed class EventMailRecipient
    {
        public string Email { get; set; } = "";
        public string Name { get; set; } = "";
        public bool IsParent { get; set; }
        public bool IsDriver { get; set; }
        public bool IsHelper { get; set; }
        public int Seats { get; set; }

        // Nur für Eltern: eigene bestätigte Kinder.
        public List<string> ChildNames { get; set; } = new();
    }


    async Task ProcessEventEmails()
    {
        if (ev == null || isSendingEventMail)
            return;

        isSendingEventMail = true;
        eventMailMessage = null;

        try
        {
            await using var Db =
                await DbFactory.CreateDbContextAsync();

            // Immer nochmals serverseitig prüfen.
            var settings = await Db.SystemSettings
                .AsNoTracking()
                .FirstOrDefaultAsync();

            if (settings?.AnmeldungEnde == null ||
                DateTime.Now <= settings.AnmeldungEnde.Value)
            {
                eventMailMessage =
                    "Das Anmeldefenster ist noch nicht beendet.";
                return;
            }

            var currentEvent = await Db.Events
                .AsNoTracking()
                .Include(x => x.Kursleiter)
                    .ThenInclude(x => x.User)
                .FirstOrDefaultAsync(x => x.Id == eventId);

            if (currentEvent == null)
            {
                eventMailMessage = "Event wurde nicht gefunden.";
                return;
            }

            var confirmedChildren = await Db.EventChildren
                .AsNoTracking()
                .Where(x =>
                    x.EventId == eventId &&
                    x.Status == EnrollmentStatus.Confirmed)
                .Include(x => x.Child)
                    .ThenInclude(x => x.ParentUser)
                .OrderBy(x => x.Child.ParentUser!.Nachname)
                .ThenBy(x => x.Child.Name)
                .ToListAsync();

            var assignments = await Db.EventRoleAssignments
                .AsNoTracking()
                .Where(x =>
                    x.EventId == eventId &&
                    (x.Role == RoleType.Driver ||
                     x.Role == RoleType.Helper))
                .Include(x => x.User)
                .ToListAsync();

            // Eine E-Mail pro eindeutiger Adresse.
            var recipients =
                new Dictionary<string, EventMailRecipient>(
                    StringComparer.OrdinalIgnoreCase);

            foreach (var registration in confirmedChildren)
            {
                var parent = registration.Child.ParentUser;

                if (parent == null ||
                    string.IsNullOrWhiteSpace(parent.Email))
                {
                    continue;
                }

                var parentRecipient = AddOrMergeRecipient(
                    recipients,
                    parent.Email,
                    $"{parent.Vorname} {parent.Nachname}".Trim(),
                    isParent: true,
                    isDriver: false,
                    isHelper: false,
                    seats: 0);

                var childName =
                    $"{registration.Child.Name} {parent.Nachname}".Trim();

                if (!parentRecipient.ChildNames.Any(x =>
                    string.Equals(
                        x,
                        childName,
                        StringComparison.OrdinalIgnoreCase)))
                {
                    parentRecipient.ChildNames.Add(childName);
                }
            }

            foreach (var assignment in assignments)
            {
                var user = assignment.User;

                if (user == null ||
                    string.IsNullOrWhiteSpace(user.Email))
                {
                    continue;
                }

                AddOrMergeRecipient(
                    recipients,
                    user.Email,
                    $"{user.Vorname} {user.Nachname}".Trim(),
                    isParent: false,
                    isDriver: assignment.Role == RoleType.Driver,
                    isHelper: assignment.Role == RoleType.Helper,
                    seats: assignment.Role == RoleType.Driver
                        ? assignment.Seats ?? 0
                        : 0);
            }

            if (!recipients.Any())
            {
                eventMailMessage =
                    "Es wurden keine gültigen E-Mail-Adressen gefunden.";
                return;
            }

            var confirmedCount = confirmedChildren.Count;
            var minimumChildren = currentEvent.MinKinder;

            // Nach Ende des Anmeldefensters entscheidet MinKinder
            // automatisch, ob Bestätigungen oder Absagen verschickt werden.
            var isCancellation =
                confirmedCount < minimumChildren;

            var allChildrenText =
                BuildChildrenList(confirmedChildren);

            var allDriversText =
                BuildDriversList(assignments);

            var allHelpersText =
                BuildHelpersList(assignments);

            var courseLeaderText =
                BuildCourseLeaderText(currentEvent);

            int sent = 0;
            var failed = new List<string>();

            foreach (var recipient in recipients.Values)
            {
                try
                {
                    // Datenschutz:
                    // Eltern sehen nur ihre eigenen bestätigten Kinder.
                    // Reine Fahrer/Betreuungspersonen sehen für die
                    // Organisation die vollständige Kinderliste.
                    //
                    // Ist eine Person gleichzeitig Elternteil und Fahrer/
                    // Betreuungsperson, gilt die strengere Elternansicht:
                    // Es werden nur die eigenen Kinder angezeigt.
                    var childrenTextForRecipient =
                        recipient.IsParent
                            ? BuildRecipientChildrenList(recipient)
                            : allChildrenText;

                    var subject = isCancellation
                        ? $"Absage – {currentEvent.Eventname}"
                        : $"Bestätigung – {currentEvent.Eventname}";

                    var body = isCancellation
                        ? BuildCancellationBody(
                            currentEvent,
                            recipient,
                            confirmedCount,
                            minimumChildren,
                            childrenTextForRecipient,
                            allDriversText,
                            allHelpersText,
                            courseLeaderText)
                        : BuildConfirmationBody(
                            currentEvent,
                            recipient,
                            childrenTextForRecipient,
                            allDriversText,
                            allHelpersText,
                            courseLeaderText);


                    var mailto =
                        "mailto:" +
                        Uri.EscapeDataString(recipient.Email) +
                        $"?subject={Uri.EscapeDataString(subject)}" +
                        $"&body={Uri.EscapeDataString(body)}";

                    await JS.InvokeVoidAsync(
                        "open",
                        mailto,
                        "_blank");

                    sent++;
                }
                catch (Exception ex)
                {
                    failed.Add(
                        $"{recipient.Email}: {ex.Message}");
                }
            }

            if (failed.Any())
            {
                eventMailMessage =
                    $"{sent} E-Mail(s) versendet, " +
                    $"{failed.Count} fehlgeschlagen: " +
                    string.Join(" | ", failed);
            }
            else
            {
                eventMailMessage = isCancellation
                    ? $"{sent} Absage-E-Mail(s) wurden versendet."
                    : $"{sent} Bestätigungs-E-Mail(s) wurden versendet.";
            }
        }
        catch (Exception ex)
        {
            eventMailMessage =
                $"Fehler beim Mailversand: {ex.Message}";
        }
        finally
        {
            isSendingEventMail = false;
        }
    }


    private static EventMailRecipient AddOrMergeRecipient(
        Dictionary<string, EventMailRecipient> recipients,
        string email,
        string name,
        bool isParent,
        bool isDriver,
        bool isHelper,
        int seats)
    {
        email = email.Trim();

        if (!recipients.TryGetValue(email, out var recipient))
        {
            recipient = new EventMailRecipient
                {
                    Email = email,
                    Name = name
                };

            recipients[email] = recipient;
        }

        if (string.IsNullOrWhiteSpace(recipient.Name) &&
            !string.IsNullOrWhiteSpace(name))
        {
            recipient.Name = name;
        }

        recipient.IsParent |= isParent;
        recipient.IsDriver |= isDriver;
        recipient.IsHelper |= isHelper;

        if (isDriver)
        {
            recipient.Seats =
                Math.Max(recipient.Seats, seats);
        }

        return recipient;
    }


    private static string BuildRecipientChildrenList(
        EventMailRecipient recipient)
    {
        var lines = recipient.ChildNames
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .Select(x => $"- {x}")
            .ToList();

        return lines.Any()
            ? string.Join(Environment.NewLine, lines)
            : "- Keine eigenen bestätigten Kinder";
    }


    private static string BuildChildrenList(

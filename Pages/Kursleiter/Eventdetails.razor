    private async Task SendSmtpMailAsync(
    string recipient,
    string subject,
    string body)
    {
        var host =
            Configuration["Email:Smtp"];

        var username =
            Configuration["Email:User"];

        var password =
            Configuration["Email:Pass"];

        var from =
            Configuration["Email:From"];

        var port =
            int.TryParse(
                Configuration["Email:Port"],
                out var configuredPort)
                    ? configuredPort
                    : 587;

        if (string.IsNullOrWhiteSpace(host))
            throw new InvalidOperationException(
                "SMTP-Server fehlt in der Konfiguration.");

        if (string.IsNullOrWhiteSpace(from))
            throw new InvalidOperationException(
                "SMTP-Absender fehlt in der Konfiguration.");

        using var message = new MailMessage();

        message.From =
            new MailAddress(
                from,
                "Ferienspass");

        message.To.Add(recipient);
        message.Subject = subject;
        message.Body = body;
        message.IsBodyHtml = false;

        using var client =
            new SmtpClient(host, port);

        client.EnableSsl = true;

        client.Credentials =
            new NetworkCredential(
                username,
                password);

        await client.SendMailAsync(message);
    }


    // =========================================================
    // MAIL AN ELTERN
    // =========================================================

    async Task OpenRecruitmentMail()
    {
        if (ev == null)
            return;


        await using var Db =
            await DbFactory.CreateDbContextAsync();


        var recipients = await Db.EventChildren
            .Where(x =>
                x.EventId == eventId &&
                x.Status == EnrollmentStatus.Confirmed)
            .Select(x => x.Child.ParentUser.Email)
            .Where(x =>
                x != null &&
                x != "")
            .Distinct()
            .ToListAsync();


        if (!recipients.Any())
            return;


        var missingText = new List<string>();


        if (missingSeats > 0)
        {
            missingText.Add(
                $"Für den Transport fehlen uns aktuell noch " +
                $"Fahrer. " +
                "Falls Sie als Fahrer oder Fahrerin mithelfen können, " +
                "teilen Sie uns bitte auch mit, wie viele Sitzplätze " +
                "Sie zur Verfügung stellen können.");
        }


        if (missingHelper > 0)
        {
            missingText.Add(
                $"Zusätzlich suchen wir noch " +
                $"helfende Betreuungsperson.");
        }


        var kursleiterNames =
            ev.Kursleiter?
                .Where(x => x.User != null)
                .Select(x =>
                    $"{x.User!.Vorname} {x.User.Nachname}".Trim())
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .ToList()
            ?? new List<string>();


        var kursleiterText =
            kursleiterNames.Any()
                ? string.Join(", ", kursleiterNames)
                : "Ferienspass-Team";


        var subject =
            $"Unterstützung gesucht für {ev.Eventname}";


        var body =
            $"Liebe Eltern und Erziehungsberechtigte,\n\n" +

            $"für den Anlass \"{ev.Eventname}\" " +

            $"am {ev.StartZeit?.ToString("dd.MM.yyyy")} " +

            "benötigen wir noch Unterstützung.\n\n" +

            string.Join("\n\n", missingText) +

            "\n\n" +

            "Falls Sie uns unterstützen können, " +
            "melden Sie sich bitte bei uns.\n\n" +

            "Vielen Dank für Ihre Mithilfe.\n\n" +

            "Freundliche Grüsse\n" +

            kursleiterText;


        var recipientString =
            string.Join(",", recipients);


        var mailto =
            "mailto:" +
            $"?bcc={Uri.EscapeDataString(recipientString)}" +
            $"&subject={Uri.EscapeDataString(subject)}" +
            $"&body={Uri.EscapeDataString(body)}";


        await JS.InvokeVoidAsync(
            "open",
            mailto,
            "_self");
    }



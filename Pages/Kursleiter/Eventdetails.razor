    // EXCEL EXPORT
    // =========================================================

    async Task ExportExcel()
    {
        await using var Db =
            await DbFactory.CreateDbContextAsync();

        if (ev == null)
            return;


        using var workbook = new XLWorkbook();

        var worksheet =
            workbook.Worksheets.Add("Teilnehmer");


        // =====================================================
        // TEILNEHMER HEADER
        // =====================================================

        worksheet.Cell(1, 1).Value = $"Bestätigt: {GetCount(ev.Id, EnrollmentStatus.Confirmed)}";
        worksheet.Cell(2, 1).Value = $"Warteliste: {GetCount(ev.Id, EnrollmentStatus.WaitingList)}";

        worksheet.Cell(3, 1).Value = "Kind";
        worksheet.Cell(3, 2).Value = "Alter";
        worksheet.Cell(3, 3).Value = "Klasse";
        worksheet.Cell(3, 4).Value = "Status";
        worksheet.Cell(3, 5).Value = "Allergien";
        worksheet.Cell(3, 6).Value = "Notfallkontakt";
        worksheet.Cell(3, 7).Value = "Telefonnummer";
        worksheet.Cell(3, 8).Value = "Beziehungsstatus";
        worksheet.Cell(3, 9).Value = "Besonderes";
        worksheet.Cell(3, 10).Value = "Ort";


        int row = 4;


        foreach (var entry in registrations)
        {
            var contacts = Db.EmergencyContacts
                .Where(x =>
                    x.ApplicationUserId ==
                    entry.Child.ParentUserId)
                .Select(x => new
                {
                    Name = x.Name,
                    Telefon = x.Telefon ?? "-",
                    Beziehung = x.Beziehung ?? "-"
                })
                .Take(1)
                .ToList();


            if (!contacts.Any())
            {
                var parentContact = Db.Users
                    .Where(x =>
                        x.Id ==
                        entry.Child.ParentUserId)
                    .Select(x => new
                    {
                        Name =
                            ((x.Vorname ?? "") +
                             " " +
                             (x.Nachname ?? ""))
                            .Trim(),

                        Telefon =
                            x.Telefonnummer ?? "-",

                        Beziehung =
                            "Kontoinhaber"
                    })
                    .FirstOrDefault();


                if (parentContact != null)
                {
                    contacts.Add(parentContact);
                }
            }


            worksheet.Cell(row, 1).Value =
                $"{entry.Child.Name} " +
                $"{entry.Child.ParentUser?.Nachname}"
                .Trim();


            worksheet.Cell(row, 2).Value =
                entry.Child.Alter;


            worksheet.Cell(row, 3).Value =
                entry.Child.Klasse switch
                {
                    KlasseStufe.KiGa1 =>
                        "1. Kindergarten",

                    KlasseStufe.KiGa2 =>
                        "2. Kindergarten",

                    KlasseStufe.Klasse1 =>
                        "1. Klasse",

                    KlasseStufe.Klasse2 =>
                        "2. Klasse",

                    KlasseStufe.Klasse3 =>
                        "3. Klasse",

                    KlasseStufe.Klasse4 =>
                        "4. Klasse",

                    KlasseStufe.Klasse5 =>
                        "5. Klasse",

                    KlasseStufe.Klasse6 =>
                        "6. Klasse",

                    KlasseStufe.Klasse7 =>
                        "7. Klasse",

                    KlasseStufe.Klasse8 =>
                        "8. Klasse",

                    KlasseStufe.Klasse9 =>
                        "9. Klasse",

                    _ => ""
                };


            worksheet.Cell(row, 4).Value =
                GetStatusText(entry.Status);

            worksheet.Cell(row, 5).Value =
                entry.Child.Allergien;

            worksheet.Cell(row, 6).Value =
                contacts.ElementAtOrDefault(0)?.Name;

            worksheet.Cell(row, 7).Value =
                contacts.ElementAtOrDefault(0)?.Telefon;

            worksheet.Cell(row, 8).Value =
                contacts.ElementAtOrDefault(0)?.Beziehung;

            worksheet.Cell(row, 9).Value =
                entry.Child.Besonderes;

            worksheet.Cell(row, 10).Value =
                entry.Child.ParentUser?.Ort;


            row++;
        }


        // =====================================================
        // FAHRER
        // =====================================================

        var drivers = await Db.EventRoleAssignments
            .Include(x => x.User)
            .Where(x =>
                x.EventId == eventId &&
                x.Role == RoleType.Driver)
            .ToListAsync();


        var wsDrivers =
            workbook.Worksheets.Add("Fahrer");


        wsDrivers.Cell(1, 1).Value = "User";
        wsDrivers.Cell(1, 2).Value = "Telefonnummer";
        wsDrivers.Cell(1, 3).Value = "Sitzplätze";
        wsDrivers.Cell(1, 4).Value = "Ort";
        wsDrivers.Cell(1, 5).Value = "E-Mail";


        if (ev.BrauchtFahrer)
        {
            wsDrivers.Cell(1, 6).Value =
                $"Fehlende Sitzplätze: {missingSeats}";


            int r = 2;


            if (drivers.Any())
            {
                foreach (var d in drivers)
                {
                    wsDrivers.Cell(r, 1).Value =
                        $"{d.User?.Vorname} " +
                        $"{d.User?.Nachname}"
                        .Trim();

                    wsDrivers.Cell(r, 2).Value =
                        d.User?.Telefonnummer;

                    wsDrivers.Cell(r, 3).Value =
                        d.Seats ?? 0;

                    wsDrivers.Cell(r, 4).Value =
                        d.User?.Ort;

                    wsDrivers.Cell(r, 5).Value =
                        d.User?.Email;

                    r++;
                }
            }
            else
            {
                wsDrivers.Cell(2, 1).Value =
                    "Es hat sich noch kein Fahrer angemeldet.";
            }
        }
        else
        {
            wsDrivers.Cell(2, 1).Value =
                "Es werden für diesen Event keine Fahrer benötigt.";
        }


        // =====================================================
        // BETREUUNG
        // =====================================================

        var helpers = await Db.EventRoleAssignments
            .Include(x => x.User)
            .Where(x =>
                x.EventId == eventId &&
                x.Role == RoleType.Helper)
            .ToListAsync();


        var wsHelpers =
            workbook.Worksheets.Add("Betreuung");


        wsHelpers.Cell(1, 1).Value = "User";
        wsHelpers.Cell(1, 2).Value = "Telefonnummer";
        wsHelpers.Cell(1, 3).Value = "Ort";
        wsHelpers.Cell(1, 4).Value = "E-Mail";


        if (ev.BrauchtBetreuung)
        {
            wsHelpers.Cell(1, 5).Value =
                $"Fehlende Betreuungspersonen: {missingHelper}";


            int r2 = 2;


            if (helpers.Any())
            {
                foreach (var h in helpers)
                {
                    wsHelpers.Cell(r2, 1).Value =
                        $"{h.User?.Vorname} " +
                        $"{h.User?.Nachname}"
                        .Trim();

                    wsHelpers.Cell(r2, 2).Value =
                        h.User?.Telefonnummer;

                    wsHelpers.Cell(r2, 3).Value =
                        h.User?.Ort;

                    wsHelpers.Cell(r2, 4).Value =
                        h.User?.Email;

                    r2++;
                }
            }
            else
            {
                wsHelpers.Cell(2, 1).Value =
                    "Es hat sich noch niemand als Betreuungsperson eingetragen.";
            }
        }
        else
        {
            wsHelpers.Cell(2, 1).Value =
                "Es werden für diesen Event keine Betreuungspersonen benötigt.";
        }


        // =====================================================
        // SPALTENBREITEN
        // =====================================================

        worksheet.Columns().AdjustToContents();
        wsDrivers.Columns().AdjustToContents();
        wsHelpers.Columns().AdjustToContents();


        // =====================================================
        // DOWNLOAD
        // =====================================================

        using var stream = new MemoryStream();

        workbook.SaveAs(stream);

        stream.Position = 0;


        var fileName =
            $"Event_{ev.Eventname}_Teilnehmer.xlsx";


        using var streamRef =
            new DotNetStreamReference(
                stream: stream);


        await JS.InvokeVoidAsync(
            "downloadFileFromStream",
            fileName,
            streamRef);
    }

    int GetCount(int eventId, EnrollmentStatus status)
    {
        using var Db = DbFactory.CreateDbContext();

        return Db.EventChildren.Count(x =>
            x.EventId == eventId &&
            x.Status == status);
    }

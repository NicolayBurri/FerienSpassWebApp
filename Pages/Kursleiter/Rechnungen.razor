@page "/kursleiter/rechnungen"

@using Microsoft.EntityFrameworkCore
@using FerienspassWebApp.Models
@using FerienspassWebApp.Data
@using Microsoft.AspNetCore.Authorization
@using ClosedXML.Excel
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components

@attribute [Authorize(Roles = "Admin,Kursleiter")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Rechnungsverwaltung</PageTitle>

<h3>Rechnungsverwaltung</h3>


@* =========================================================
   ZAHLUNG ÜBER REFERENZNUMMER - NUR ADMIN
   ========================================================= *@

<AuthorizeView Roles="Admin">

    <div style="margin-bottom:20px;">

        <div class="d-flex gap-2"
             style="max-width:600px;">

            <input class="form-control"
                   placeholder="Referenznummer eingeben"
                   @bind="searchReference" />

            <button class="btn btn-success"
                    @onclick="SearchInvoiceForPayment">
                Prüfen
            </button>

        </div>

        @if (!string.IsNullOrWhiteSpace(paymentSearchError))
        {
            <div class="alert alert-danger mt-2">
                @paymentSearchError
            </div>
        }

    </div>

    @if (showPaymentModal && paymentInvoice != null)
    {
        <div class="modal fade show d-block"
             tabindex="-1"
             style="background-color:rgba(0,0,0,0.5);">

            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Zahlung kontrollieren
                        </h5>

                        <button type="button"
                                class="btn-close"
                                @onclick="ClosePaymentModal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="alert alert-info">
                            Bitte kontrollieren Sie die Angaben,
                            bevor die Zahlung bestätigt wird.
                        </div>

                        <table class="table">

                            <tbody>

                                <tr>
                                    <th>Referenznummer</th>
                                    <td>
                                        @paymentInvoice.Reference
                                    </td>
                                </tr>

                                <tr>
                                    <th>Name</th>
                                    <td>
                                        @paymentInvoice.ParentUser?.Vorname
                                        @paymentInvoice.ParentUser?.Nachname
                                    </td>
                                </tr>

                                <tr>
                                    <th>E-Mail</th>
                                    <td>
                                        @(paymentInvoice.ParentUser?.Email ?? "-")
                                    </td>
                                </tr>

                                <tr>
                                    <th>Adresse</th>
                                    <td>
                                        @(paymentInvoice.ParentUser?.Strasse ?? "-")
                                        <br />
                                        @(paymentInvoice.ParentUser?.PLZ ?? "")
                                        @(paymentInvoice.ParentUser?.Ort ?? "")
                                    </td>
                                </tr>

                                <tr>
                                    <th>Betrag</th>
                                    <td>
                                        <strong>
                                            CHF @paymentInvoice.TotalAmount.ToString("0.00")
                                        </strong>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Aktueller Status</th>
                                    <td>
                                        @GetText(paymentInvoice.Status)
                                    </td>
                                </tr>

                            </tbody>

                        </table>


                        @if (paymentInvoice.Status == InvoiceStatus.Paid)
                        {
                            <div class="alert alert-warning">
                                Diese Rechnung ist bereits als bezahlt markiert.
                            </div>
                        }

                    </div>

                    <div class="modal-footer">

                        <button class="btn btn-secondary"
                                @onclick="ClosePaymentModal">
                            Abbrechen
                        </button>

                        @if (paymentInvoice.Status != InvoiceStatus.Paid)
                        {
                            <button class="btn btn-success"
                                    @onclick="ConfirmPayment">
                                Zahlung bestätigen
                            </button>
                        }

                    </div>

                </div>
            </div>
        </div>
    }

    <hr />

</AuthorizeView>

@* =========================================================
   BUCHHALTUNG / JAHRESAUSWERTUNG
   ========================================================= *@

<AuthorizeView Roles="Admin">
    <button class="btn btn-primary mb-3"
            @onclick="OpenAccountingModal">
        Buchhaltung
    </button>
</AuthorizeView>

 <AuthorizeView Roles="Admin">
    @if (showAccountingModal)
    {
        <div class="modal fade show d-block"
             tabindex="-1"
             style="background-color:rgba(0,0,0,0.5);">

            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            Buchhaltung
                        </h5>

                        <button type="button"
                                class="btn-close"
                                @onclick="CloseAccountingModal">
                        </button>
                    </div>

                    <div class="modal-body">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Jahr
                                </label>

                                <select class="form-select"
                                        @bind="AccountingYear">

                                    @foreach (var year in AccountingYears)
                                    {
                                        <option value="@year">
                                            @year
                                        </option>
                                    }

                                </select>

                            </div>

                        </div>

                        <hr />

                        <div class="row g-3">

                            <div class="col-md-3">
                                <strong>Total Rechnungen</strong><br />
                                CHF @AccountingTotal.ToString("0.00")
                            </div>

                            <div class="col-md-3">
                                <strong>Noch geschuldet</strong><br />
                                CHF @AccountingOutstanding.ToString("0.00")
                            </div>

                            <div class="col-md-3">
                                <strong>Rückerstattet</strong><br />
                                CHF @AccountingRefunded.ToString("0.00")
                            </div>

                            <div class="col-md-3">
                                <strong>Netto bezahlt</strong><br />
                                CHF @AccountingNetPaid.ToString("0.00")
                            </div>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button class="btn btn-secondary"
                                @onclick="CloseAccountingModal">
                            Schliessen
                        </button>

                        <button class="btn btn-success"
                                @onclick="ExportAccountingExcel">
                            Excel erstellen
                        </button>

                    </div>

                </div>
            </div>
        </div>
    }
 </AuthorizeView>


@* =========================================================
   FILTER
   ========================================================= *@

<div class="card mb-4">
    <div class="card-body">

        <h5 class="card-title mb-3">
            Rechnungen filtern
        </h5>

        <div class="row g-3">

            @* Familienname *@
            <div class="col-md-4">

                <label class="form-label">
                    Familie
                </label>

                <input class="form-control"
                       placeholder="Nach Familienname suchen..."
                       @bind="FilterName"
                       @bind:event="oninput" />

            </div>


            @* E-Mail *@
            <div class="col-md-4">

                <label class="form-label">
                    E-Mail
                </label>

                <input class="form-control"
                       placeholder="Nach E-Mail suchen..."
                       @bind="FilterEmail"
                       @bind:event="oninput" />

            </div>


            @* Status *@
            <div class="col-md-4">

                <label class="form-label">
                    Status
                </label>

                <select class="form-select"
                        @bind="FilterStatus">

                    <option value="">
                        Alle Status
                    </option>

                    <option value="Open">
                        Offen
                    </option>

                    <option value="Reminder">
                        Mahnung
                    </option>

                    <option value="Paid">
                        Bezahlt
                    </option>

                    <option value="PartlyRefundet">
                        Teilweise zurückerstattet
                    </option>

                    <option value="Refunded">
                        Zurückerstattet
                    </option>

                </select>

            </div>

        </div>


        @* Filter zurücksetzen *@
        <div class="mt-3">

            <button class="btn btn-outline-secondary"
                    @onclick="ResetFilters">
                Filter zurücksetzen
            </button>

            <span class="ms-3 text-muted">
                @filteredInvoices.Count Rechnung(en) gefunden
            </span>

        </div>

    </div>
</div>


@* =========================================================
   RECHNUNGSTABELLE
   ========================================================= *@

@if (!filteredInvoices.Any())
{
    <div class="alert alert-info">
        Keine Rechnungen mit diesen Filterkriterien gefunden.
    </div>
}
else
{
    <table class="table">

        <thead>
            <tr>

                <th>Referenz</th>

                <th>Familie</th>

                <th>E-Mail</th>

                <th>Datum</th>

                <th>Total</th>

                <th>Status</th>

                <AuthorizeView Roles="Admin">
                    <th>Ändern</th>
                </AuthorizeView>

            </tr>
        </thead>

        <tbody>

            @foreach (var invoice in pagedInvoices)
            {
                var refunds = refundRequests
                .Where(x => x.InvoiceId == invoice.Id)
                .ToList();

                <tr>

                    @* Referenz *@
                    <td>
                        @invoice.Reference
                    </td>


                    @* Familie *@
                    <td>
                        @invoice.ParentUser?.Nachname
                    </td>


                    @* E-Mail *@
                    <td>
                        @invoice.ParentUser?.Email
                    </td>


                    @* Rechnungsdatum *@
                    <td>
                        @invoice.CreatedAt.ToString("dd.MM.yyyy")
                    </td>


                    @* Total *@
                    <td>
                        CHF @invoice.TotalAmount
                    </td>


                    @* Status *@
                    <td>

                        <span style="color:@GetColor(invoice.Status);
                                     font-weight:bold;">

                            @GetText(invoice.Status)

                        </span>

                    </td>


                    @* Status ändern - nur Admin *@
                    <AuthorizeView Roles="Admin">

                        <td>

                            <select class="form-select"
                                    value="@invoice.Status"
                                    @onchange="e => ChangeStatus(
                                        invoice,
                                        e.Value?.ToString())">

                                <option value="Open">
                                    Offen
                                </option>

                                <option value="Reminder">
                                    Mahnung
                                </option>

                                <option value="Paid">
                                    Bezahlt
                                </option>


                                @if (invoice.Status ==
                               InvoiceStatus.PartlyRefundet)
                                {
                                    <option value="PartlyRefundet">
                                        Teilweise zurückerstattet
                                    </option>
                                }


                                @if (invoice.Status ==
                               InvoiceStatus.Refunded)
                                {
                                    <option value="Refunded">
                                        Zurückerstattet
                                    </option>
                                }

                            </select>

                        </td>

                    </AuthorizeView>

                </tr>


                @* =================================================
        OFFENE RÜCKERSTATTUNGEN
        ================================================= *@

                @if (refunds.Any())
                {
                    <tr>

                        <td colspan="7"
                            style="
                                background:#fff3cd;
                                color:#842029;
                                font-weight:bold;
                                        ">

                            <div style="margin-bottom:10px;">
                                Rückerstattung erforderlich:
                            </div>


                            @foreach (var refund in refunds)
                            {
                                <div style="
                                    display:flex;
                                    align-items:center;
                                    justify-content:space-between;
                                    flex-wrap:wrap;
                                    gap:10px;
                                    padding:10px;
                                    margin-bottom:8px;
                                    background:white;
                                    border:1px solid #e5c365;
                                    border-radius:6px;
                                                ">

                                    <span>

                                        @refund.ChildName –

                                        @refund.EventName –

                                        CHF @refund.Amount

                                    </span>


                                    <AuthorizeView Roles="Admin">

                                        <button class="btn btn-sm btn-success"
                                                @onclick="() =>
                                                    ConfirmRefund(refund.Id)">

                                            Rückerstattung bestätigen

                                        </button>

                                    </AuthorizeView>

                                </div>
                            }


                            <AuthorizeView Roles="Kursleiter">

                                <p style="margin:8px 0 0 0;">

                                    Die Rückerstattung muss durch
                                    einen Administrator bestätigt werden.

                                </p>

                            </AuthorizeView>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>


    @* =========================================================
       PAGINATION
       ========================================================= *@

    @if (totalPages > 1)
    {
        <div class="mt-3"
             style="
                display:flex;
                gap:8px;
                flex-wrap:wrap;
                align-items:center;
                     ">

            @* Zurück *@
            <button class="btn btn-secondary"
                    @onclick="PreviousPage"
                    disabled="@(currentPage == 1)">

                ← Zurück

            </button>


            @* Seitenzahlen *@
            @for (int i = 1; i <= totalPages; i++)
            {
                var pageNumber = i;

                <button class="btn @(pageNumber == currentPage
                    ? "btn-primary"
                    : "btn-outline-primary")"
                        @onclick="() => GoToPage(pageNumber)">

                    @pageNumber

                </button>
            }


            @* Weiter *@
            <button class="btn btn-secondary"
                    @onclick="NextPage"
                    disabled="@(currentPage == totalPages)">

                Weiter →

            </button>

        </div>
    }
}


@code {

    // =========================================================
    // DATEN
    // =========================================================

    private List<Invoice> invoices = new();

    private List<RefundRequest> refundRequests = new();

    private List<RefundRequest> allRefundRequests = new();

    private bool showAccountingModal = false;

    private void OpenAccountingModal()
    {
        showAccountingModal = true;
    }

    private void CloseAccountingModal()
    {
        showAccountingModal = false;
    }


    // =========================================================
    // REFERENZ-SUCHE
    // =========================================================

    private string? searchReference;

    private Invoice? paymentInvoice;

    private bool showPaymentModal = false;

    private string? paymentSearchError;


    // =========================================================
    // FILTER
    // =========================================================

    private string _filterName = "";

    private string _filterEmail = "";

    private string _filterStatus = "";


    private string FilterName
    {
        get => _filterName;

        set
        {
            _filterName = value ?? "";

            // Bei einer neuen Suche wieder auf Seite 1
            currentPage = 1;
        }
    }


    private string FilterEmail
    {
        get => _filterEmail;

        set
        {
            _filterEmail = value ?? "";

            currentPage = 1;
        }
    }


    private string FilterStatus
    {
        get => _filterStatus;

        set
        {
            _filterStatus = value ?? "";

            currentPage = 1;
        }
    }


    // =========================================================
    // GEFILTERTE RECHNUNGEN
    // =========================================================

    private List<Invoice> filteredInvoices =>
        invoices
            .Where(invoice =>

                // ---------------------------------------------
                // Familienname
                // ---------------------------------------------

                (
                    string.IsNullOrWhiteSpace(FilterName)

                    ||

                    (
                        invoice.ParentUser?.Nachname?
                            .Contains(
                                FilterName.Trim(),
                                StringComparison.OrdinalIgnoreCase
                            )
                        ?? false
                    )
                )


                &&


                // ---------------------------------------------
                // E-Mail
                // ---------------------------------------------

                (
                    string.IsNullOrWhiteSpace(FilterEmail)

                    ||

                    (
                        invoice.ParentUser?.Email?
                            .Contains(
                                FilterEmail.Trim(),
                                StringComparison.OrdinalIgnoreCase
                            )
                        ?? false
                    )
                )


                &&


                // ---------------------------------------------
                // Status
                // ---------------------------------------------

                (
                    string.IsNullOrWhiteSpace(FilterStatus)

                    ||

                    invoice.Status.ToString() == FilterStatus
                )

            )
            .ToList();


    // =========================================================
    // PAGINATION
    // =========================================================

    private int currentPage = 1;

    private const int pageSize = 10;


    private List<Invoice> pagedInvoices =>
        filteredInvoices
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();


    private int totalPages =>
        (int)Math.Ceiling(
            filteredInvoices.Count / (double)pageSize
        );

    // =========================================================
    // BUCHHALTUNG
    // =========================================================

    private int AccountingYear = DateTime.Now.Year;

    private List<int> AccountingYears =>
        invoices
            .Select(x => x.CreatedAt.Year)
            .Distinct()
            .OrderByDescending(x => x)
            .ToList();

    private List<Invoice> AccountingInvoice =>
        invoices
            .Where(x => x.CreatedAt.Year == AccountingYear)
            .ToList();

    private decimal AccountingTotal =>
        AccountingInvoice.Sum(x => x.TotalAmount);

    private decimal AccountingOutstanding =>
        AccountingInvoice
            .Where(x =>
                x.Status == InvoiceStatus.Open ||
                x.Status == InvoiceStatus.Reminder)
            .Sum(x => x.TotalAmount);

    private decimal AccountingRefunded
    {
        get
        {
            var invoiceIds = AccountingInvoice
                .Select(x => x.Id)
                .ToHashSet();

            return allRefundRequests
                .Where(x =>
                    invoiceIds.Contains(x.InvoiceId) &&
                    x.IsRefundet)
                .Sum(x => (decimal)(x.Amount ?? 0));
        }
    }

    private decimal AccountingPaid =>
        AccountingInvoice
            .Where(x =>
                x.Status == InvoiceStatus.Paid ||
                x.Status == InvoiceStatus.PartlyRefundet ||
                x.Status == InvoiceStatus.Refunded)
            .Sum(x => x.TotalAmount);

    private decimal AccountingNetPaid =>
        AccountingPaid - AccountingRefunded;

    // =========================================================
    // INITIALISIERUNG
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoices();
    }


    // =========================================================
    // RECHNUNGEN LADEN
    // =========================================================

    private async Task LoadInvoices()
    {
        await using var Db =
            await DbFactory.CreateDbContextAsync();


        invoices = await Db.Invoices

            .AsNoTracking()

            .Include(x => x.ParentUser)

            .OrderByDescending(x => x.CreatedAt)

            .ToListAsync();


        // Nur noch nicht bestätigte Rückerstattungen anzeigen

        refundRequests = await Db.RefundRequests

            .AsNoTracking()

            .Where(x => !x.IsRefundet)

            .OrderByDescending(x => x.CreatedAt)

            .ToListAsync();

        allRefundRequests = await Db.RefundRequests
            .AsNoTracking()
            .ToListAsync();


        // Falls nach einer Änderung die aktuelle Seite
        // nicht mehr existiert, auf die letzte gültige Seite.

        if (currentPage > totalPages)
        {
            currentPage =
                totalPages == 0
                    ? 1
                    : totalPages;
        }
    }


    // =========================================================
    // FILTER ZURÜCKSETZEN
    // =========================================================

    private void ResetFilters()
    {
        _filterName = "";

        _filterEmail = "";

        _filterStatus = "";

        currentPage = 1;
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages)
        {
            return;
        }

        currentPage = page;
    }


    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
        }
    }


    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }


    // =========================================================
    // REFERENZ ALS BEZAHLT MARKIEREN
    // =========================================================

    
    // RECHNUNG FÜR ZAHLUNG SUCHEN

    private async Task SearchInvoiceForPayment()
    {
        if (!await IsAdmin())
            return;

        paymentSearchError = null;
        paymentInvoice = null;


        if (string.IsNullOrWhiteSpace(searchReference))
        {
            paymentSearchError =
                "Bitte eine Referenznummer eingeben.";

            return;
        }


        await using var Db =
            await DbFactory.CreateDbContextAsync();


        var invoice = await Db.Invoices
            .AsNoTracking()
            .Include(x => x.ParentUser)
            .FirstOrDefaultAsync(x =>
                x.Reference == searchReference.Trim());


        if (invoice == null)
        {
            paymentSearchError =
                "Es wurde keine Rechnung mit dieser Referenznummer gefunden.";

            return;
        }


        paymentInvoice = invoice;

        showPaymentModal = true;
    }

    // ZAHLUNG BESTÄTIGEN

    private async Task ConfirmPayment()
    {
        if (!await IsAdmin())
            return;

        if (paymentInvoice == null)
            return;

        await using var Db =
            await DbFactory.CreateDbContextAsync();

        var invoice = await Db.Invoices
            .FirstOrDefaultAsync(x =>
                x.Id == paymentInvoice.Id);

        if (invoice == null)
        {
            paymentSearchError =
                "Die Rechnung wurde nicht mehr gefunden.";

            return;
        }

        // Status wirklich ändern
        invoice.Status = InvoiceStatus.Paid;
        invoice.PaidAt = DateTime.Now;

        await Db.SaveChangesAsync();

        // Zur Kontrolle nochmals frisch aus DB lesen
        var savedInvoice = await Db.Invoices
            .AsNoTracking()
            .FirstOrDefaultAsync(x =>
                x.Id == invoice.Id);

        if (savedInvoice == null ||
            savedInvoice.Status != InvoiceStatus.Paid)
        {
            paymentSearchError =
                "Der Zahlungsstatus konnte nicht gespeichert werden.";

            return;
        }

        // Popup schliessen
        showPaymentModal = false;
        paymentInvoice = null;
        searchReference = "";
        paymentSearchError = null;

        // Tabelle neu laden
        await LoadInvoices();

        StateHasChanged();
    }

    // ZAHLUNGS-POPUP SCHLIESSEN

    private void ClosePaymentModal()
    {
        showPaymentModal = false;

        paymentInvoice = null;
    }


    // =========================================================
    // STATUS ÄNDERN
    // =========================================================

    private async Task ChangeStatus(
        Invoice invoice,
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }


        if (!Enum.TryParse<InvoiceStatus>(
                value,
                out var newStatus))
        {
            return;
        }


        // Rückerstattungsstatus dürfen nicht manuell
        // über das Dropdown gesetzt werden.

        if (newStatus == InvoiceStatus.Refunded ||
            newStatus == InvoiceStatus.PartlyRefundet)
        {
            return;
        }


        await using var Db =
            await DbFactory.CreateDbContextAsync();


        var dbInvoice = await Db.Invoices
            .FirstOrDefaultAsync(x =>
                x.Id == invoice.Id);


        if (dbInvoice == null)
        {
            return;
        }


        dbInvoice.Status = newStatus;


        // Bezahlt

        if (newStatus == InvoiceStatus.Paid)
        {
            dbInvoice.PaidAt = DateTime.Now;
        }


        // Mahnung

        if (newStatus == InvoiceStatus.Reminder)
        {
            dbInvoice.ReminderSentAt = DateTime.Now;
        }


        await Db.SaveChangesAsync();


        await LoadInvoices();
    }


    // =========================================================
    // RÜCKERSTATTUNG BESTÄTIGEN
    // =========================================================

    private async Task ConfirmRefund(int refundId)
    {
        await using var Db =
            await DbFactory.CreateDbContextAsync();


        var refund = await Db.RefundRequests
            .FirstOrDefaultAsync(x =>
                x.Id == refundId);


        if (refund == null || refund.IsRefundet)
        {
            return;
        }


        refund.IsRefundet = true;


        await Db.SaveChangesAsync();


        await UpdateInvoiceRefundStatus(
            Db,
            refund.InvoiceId);


        await LoadInvoices();
    }


    // =========================================================
    // RECHNUNGSSTATUS NACH RÜCKERSTATTUNG AKTUALISIEREN
    // =========================================================

    private static async Task UpdateInvoiceRefundStatus(
        ApplicationDbContext Db,
        int invoiceId)
    {
        var invoice = await Db.Invoices
            .FirstOrDefaultAsync(x =>
                x.Id == invoiceId);


        if (invoice == null)
        {
            return;
        }


        var refunds = await Db.RefundRequests
            .Where(x => x.InvoiceId == invoiceId)
            .ToListAsync();


        if (!refunds.Any())
        {
            return;
        }


        var confirmedCount =
            refunds.Count(x => x.IsRefundet);


        // Alle Rückerstattungen bestätigt

        if (confirmedCount == refunds.Count)
        {
            invoice.Status =
                InvoiceStatus.Refunded;
        }

        // Mindestens eine Rückerstattung bestätigt

        else if (confirmedCount > 0)
        {
            invoice.Status =
                InvoiceStatus.PartlyRefundet;
        }


        await Db.SaveChangesAsync();
    }


    // =========================================================
    // STATUS-FARBE
    // =========================================================

    private static string GetColor(
        InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Open =>
                "orange",

            InvoiceStatus.Reminder =>
                "red",

            InvoiceStatus.Paid =>
                "green",

            InvoiceStatus.Refunded =>
                "violet",

            InvoiceStatus.PartlyRefundet =>
                "purple",

            _ =>
                "black"
        };
    }


    // =========================================================
    // STATUS-TEXT
    // =========================================================

    private static string GetText(
        InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Open =>
                "Offen",

            InvoiceStatus.Reminder =>
                "Mahnung",

            InvoiceStatus.Paid =>
                "Bezahlt",

            InvoiceStatus.Refunded =>
                "Zurückerstattet",

            InvoiceStatus.PartlyRefundet =>
                "Teilweise zurückerstattet",

            _ =>
                "-"
        };
    }

    // =========================================================
    // BUCHHALTUNG EXCELEXPORT
    // =========================================================

    private async Task<bool> IsAdmin()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        return authState.User.IsInRole("Admin");
    }


    private async Task ExportAccountingExcel()
    {
        if (!await IsAdmin())
            return;

        await using var Db =
            await DbFactory.CreateDbContextAsync();

        var yearInvoices = await Db.Invoices
            .AsNoTracking()
            .Include(x => x.ParentUser)
            .Where(x => x.CreatedAt.Year == AccountingYear)
            .OrderBy(x => x.CreatedAt)
            .ToListAsync();

        var invoiceIds = yearInvoices
            .Select(x => x.Id)
            .ToList();

        var refunds = await Db.RefundRequests
            .AsNoTracking()
            .Where(x =>
                invoiceIds.Contains(x.InvoiceId) &&
                x.IsRefundet)
            .ToListAsync();


        using var workbook = new XLWorkbook();

        var worksheet =
            workbook.Worksheets.Add("Buchhaltung");


        // =====================================================
        // ZUSAMMENFASSUNG
        // =====================================================

        var total =
            yearInvoices.Sum(x => x.TotalAmount);

        var outstanding =
            yearInvoices
                .Where(x =>
                    x.Status == InvoiceStatus.Open ||
                    x.Status == InvoiceStatus.Reminder)
                .Sum(x => x.TotalAmount);

        decimal refunded =
            refunds.Sum(x => (decimal) (x.Amount ?? 0));

        var paid =
            yearInvoices
                .Where(x =>
                    x.Status == InvoiceStatus.Paid ||
                    x.Status == InvoiceStatus.PartlyRefundet ||
                    x.Status == InvoiceStatus.Refunded)
                .Sum(x => x.TotalAmount);

        var netPaid =
            paid - refunded;


        worksheet.Cell(1, 1).Value =
            $"Buchhaltung {AccountingYear}";

        worksheet.Cell(3, 1).Value =
            "Total Rechnungen";

        worksheet.Cell(3, 2).Value =
            total;


        worksheet.Cell(4, 1).Value =
            "Noch geschuldet";

        worksheet.Cell(4, 2).Value =
            outstanding;


        worksheet.Cell(5, 1).Value =
            "Rückerstattet";

        worksheet.Cell(5, 2).Value =
            refunded;


        worksheet.Cell(6, 1).Value =
            "Netto bezahlt";

        worksheet.Cell(6, 2).Value =
            netPaid;


        worksheet.Range("B3:B6")
            .Style.NumberFormat.Format =
            "CHF #,##0.00";


        // =====================================================
        // DETAILTABELLE
        // =====================================================

        worksheet.Cell(8, 1).Value = "Datum";
        worksheet.Cell(8, 2).Value = "Referenz";
        worksheet.Cell(8, 3).Value = "Familie";
        worksheet.Cell(8, 4).Value = "E-Mail";
        worksheet.Cell(8, 5).Value = "Rechnung";
        worksheet.Cell(8, 6).Value = "Status";
        worksheet.Cell(8, 7).Value = "Geschuldet";
        worksheet.Cell(8, 8).Value = "Bezahlt";
        worksheet.Cell(8, 9).Value = "Rückerstattet";
        worksheet.Cell(8, 10).Value = "Netto bezahlt";


        int row = 9;

        foreach (var invoice in yearInvoices)
        {
            decimal invoiceRefunded =
    refunds
        .Where(x => x.InvoiceId == invoice.Id)
        .Sum(x => (decimal)(x.Amount ?? 0));

            bool isOutstanding =
                invoice.Status == InvoiceStatus.Open ||
                invoice.Status == InvoiceStatus.Reminder;

            decimal outstandingAmount =
                isOutstanding
                    ? invoice.TotalAmount
                    : 0m;

            bool isPaid =
                invoice.Status == InvoiceStatus.Paid ||
                invoice.Status == InvoiceStatus.PartlyRefundet ||
                invoice.Status == InvoiceStatus.Refunded;

            decimal paidAmount =
                isPaid
                    ? invoice.TotalAmount
                    : 0m;

            decimal netAmount =
                paidAmount - invoiceRefunded;


            worksheet.Cell(row, 1).Value =
                invoice.CreatedAt;

            worksheet.Cell(row, 1)
                .Style.DateFormat.Format =
                "dd.MM.yyyy";


            worksheet.Cell(row, 2).Value =
                invoice.Reference;


            worksheet.Cell(row, 3).Value =
                invoice.ParentUser?.Nachname ?? "";


            worksheet.Cell(row, 4).Value =
                invoice.ParentUser?.Email ?? "";


            worksheet.Cell(row, 5).Value =
                invoice.TotalAmount;


            worksheet.Cell(row, 6).Value =
                GetText(invoice.Status);


            worksheet.Cell(row, 7).Value =
                outstandingAmount;

            worksheet.Cell(row, 8).Value =
                paidAmount;

            worksheet.Cell(row, 9).Value =
                invoiceRefunded;

            worksheet.Cell(row, 10).Value =
                netAmount;

            worksheet.Range(row, 5, row, 10)
                .Style.NumberFormat.Format =
                "CHF #,##0.00";

            row++;
        }


        // =====================================================
        // FORMATIERUNG
        // =====================================================

        worksheet.Row(1)
            .Style.Font.Bold = true;

        worksheet.Row(8)
            .Style.Font.Bold = true;

        worksheet.Columns()
            .AdjustToContents();


        // =====================================================
        // DOWNLOAD
        // =====================================================

        using var stream =
            new MemoryStream();

        workbook.SaveAs(stream);

        stream.Position = 0;

        var fileName =
            $"Buchhaltung_{AccountingYear}.xlsx";


        using var streamRef =
            new DotNetStreamReference(stream);


        await JS.InvokeVoidAsync(
            "downloadFileFromStream",
            fileName,
            streamRef);
    }

@page "/kursleiter/rechnungen"

@using Microsoft.EntityFrameworkCore
@using FerienspassWebApp.Models
@using FerienspassWebApp.Data
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin,Kursleiter")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Rechnungsverwaltung</PageTitle>

<h3>Rechnungsverwaltung</h3>

<div style="margin-bottom:20px;">

    <input class="form-control"
           placeholder="Referenznummer eingeben"
           @bind="searchReference" />

    <br />

    <button class="btn btn-success"
            @onclick="MarkAsPaid">
        Als bezahlt markieren
    </button>

</div>

<hr />

@if (!invoices.Any())
{
    <p>Keine Rechnungen vorhanden.</p>
}
else
{
    <table class="table">

        <thead>
            <tr>
                <th>Referenz</th>
                <th>Familie</th>
                <th>E-Mail</th>
                <th>Datum</th>
                <th>Total</th>
                <th>Status</th>

                <AuthorizeView Roles="Admin">
                    <th>Ändern</th>
                </AuthorizeView>
            </tr>
        </thead>

        <tbody>

            @foreach (var invoice in pagedInvoices)
            {
                var refunds = refundRequests
                .Where(x => x.InvoiceId == invoice.Id)
                .ToList();

                <tr>
                    <td>@invoice.Reference</td>

                    <td>@invoice.ParentUser.Nachname</td>

                    <td>@invoice.ParentUser.Email</td>

                    <td>@invoice.CreatedAt.ToString("dd.MM.yyyy")</td>

                    <td>CHF @invoice.TotalAmount</td>

                    <td>
                        <span style="color:@GetColor(invoice.Status); font-weight:bold;">
                            @GetText(invoice.Status)
                        </span>
                    </td>

                    <AuthorizeView Roles="Admin">
                        <td>
                            <select class="form-select"
                                    value="@invoice.Status"
                                    @onchange="e => ChangeStatus(invoice, e.Value?.ToString())">

                                <option value="Open">Offen</option>
                                <option value="Reminder">Mahnung</option>
                                <option value="Paid">Bezahlt</option>

                                @if (invoice.Status == InvoiceStatus.PartlyRefundet)
                                {
                                    <option value="PartlyRefundet">
                                        Teilweise zurückerstattet
                                    </option>
                                }

                                @if (invoice.Status == InvoiceStatus.Refunded)
                                {
                                    <option value="Refunded">
                                        Zurückerstattet
                                    </option>
                                }

                            </select>
                        </td>
                    </AuthorizeView>
                </tr>

                @if (refunds.Any())
                {
                    <tr>
                        <td colspan="7"
                            style="background:#fff3cd;
                                   color:#842029;
                                   font-weight:bold;">

                            <div style="margin-bottom:10px;">
                                Rückerstattung erforderlich:
                            </div>

                            @foreach (var refund in refunds)
                            {
                                <div style="display:flex;
                                            align-items:center;
                                            justify-content:space-between;
                                            flex-wrap:wrap;
                                            gap:10px;
                                            padding:10px;
                                            margin-bottom:8px;
                                            background:white;
                                            border:1px solid #e5c365;
                                            border-radius:6px;">

                                    <span>
                                        @refund.ChildName –
                                        @refund.EventName –
                                        CHF @refund.Amount
                                    </span>

                                    <AuthorizeView Roles="Admin">
                                        <button class="btn btn-sm btn-success"
                                                @onclick="() => ConfirmRefund(refund.Id)">
                                            Rückerstattung bestätigen
                                        </button>
                                    </AuthorizeView>

                                </div>
                            }

                            <AuthorizeView Roles="Kursleiter">
                                <p style="margin:8px 0 0 0;">
                                    Die Rückerstattung muss durch einen Administrator bestätigt werden.
                                </p>
                            </AuthorizeView>

                        </td>
                    </tr>
                }
            }

        </tbody>

    </table>

    @if (totalPages > 1)
    {
        <div class="mt-3"
             style="display:flex; gap:8px; flex-wrap:wrap;">

            <button class="btn btn-secondary"
                    @onclick="PreviousPage"
                    disabled="@(currentPage == 1)">
                ← Zurück
            </button>

            @for (int i = 1; i <= totalPages; i++)
            {
                var pageNumber = i;

                <button class="btn @(pageNumber == currentPage
                    ? "btn-primary"
                    : "btn-outline-primary")"
                        @onclick="() => GoToPage(pageNumber)">
                    @pageNumber
                </button>
            }

            <button class="btn btn-secondary"
                    @onclick="NextPage"
                    disabled="@(currentPage == totalPages)">
                Weiter →
            </button>

        </div>
    }
}

@code {
    private List<Invoice> invoices = new();
    private List<RefundRequest> refundRequests = new();

    private string? searchReference;

    private int currentPage = 1;
    private const int pageSize = 10;

    private List<Invoice> pagedInvoices =>
        invoices
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

    private int totalPages =>
        (int)Math.Ceiling(invoices.Count / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoices();
    }

    private async Task LoadInvoices()
    {
        await using var Db =
            await DbFactory.CreateDbContextAsync();

        invoices = await Db.Invoices
            .AsNoTracking()
            .Include(x => x.ParentUser)
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();

        // Nur noch nicht bestätigte Rückerstattungen anzeigen
        refundRequests = await Db.RefundRequests
            .AsNoTracking()
            .Where(x => !x.IsRefundet)
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();

        if (currentPage > totalPages)
        {
            currentPage = totalPages == 0
                ? 1
                : totalPages;
        }
    }

    private void GoToPage(int page)
    {
        currentPage = page;
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private async Task MarkAsPaid()
    {
        if (string.IsNullOrWhiteSpace(searchReference))
        {
            return;
        }

        await using var Db =
            await DbFactory.CreateDbContextAsync();

        var invoice = await Db.Invoices
            .FirstOrDefaultAsync(x =>
                x.Reference == searchReference.Trim());

        if (invoice == null)
        {
            return;
        }

        invoice.Status = InvoiceStatus.Paid;
        invoice.PaidAt = DateTime.Now;

        await Db.SaveChangesAsync();
        await LoadInvoices();
    }

    private async Task ChangeStatus(
        Invoice invoice,
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (!Enum.TryParse<InvoiceStatus>(
                value,
                out var newStatus))
        {
            return;
        }

        // Rückerstattungsstatus dürfen nur durch
        // einzelne Bestätigungen gesetzt werden.
        if (newStatus == InvoiceStatus.Refunded ||
            newStatus == InvoiceStatus.PartlyRefundet)
        {
            return;
        }

        await using var Db =
            await DbFactory.CreateDbContextAsync();

        var dbInvoice = await Db.Invoices
            .FirstOrDefaultAsync(x =>
                x.Id == invoice.Id);

        if (dbInvoice == null)
        {
            return;
        }

        dbInvoice.Status = newStatus;

        if (newStatus == InvoiceStatus.Paid)
        {
            dbInvoice.PaidAt = DateTime.Now;
        }

        if (newStatus == InvoiceStatus.Reminder)
        {
            dbInvoice.ReminderSentAt = DateTime.Now;
        }

        await Db.SaveChangesAsync();
        await LoadInvoices();
    }

    private async Task ConfirmRefund(int refundId)
    {
        await using var Db =
            await DbFactory.CreateDbContextAsync();

        var refund = await Db.RefundRequests
            .FirstOrDefaultAsync(x =>
                x.Id == refundId);

        if (refund == null || refund.IsRefundet)
        {
            return;
        }

        refund.IsRefundet = true;

        await Db.SaveChangesAsync();

        await UpdateInvoiceRefundStatus(
            Db,
            refund.InvoiceId);

        await LoadInvoices();
    }

    private static async Task UpdateInvoiceRefundStatus(
        ApplicationDbContext Db,
        int invoiceId)
    {
        var invoice = await Db.Invoices
            .FirstOrDefaultAsync(x =>
                x.Id == invoiceId);

        if (invoice == null)
        {
            return;
        }

        var refunds = await Db.RefundRequests
            .Where(x => x.InvoiceId == invoiceId)
            .ToListAsync();

        if (!refunds.Any())
        {
            return;
        }

        var confirmedCount =
            refunds.Count(x => x.IsRefundet);

        if (confirmedCount == refunds.Count)
        {
            invoice.Status = InvoiceStatus.Refunded;
        }
        else if (confirmedCount > 0)
        {
            invoice.Status = InvoiceStatus.PartlyRefundet;
        }

        await Db.SaveChangesAsync();
    }

    private static string GetColor(
        InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Open => "orange",
            InvoiceStatus.Reminder => "red",
            InvoiceStatus.Paid => "green",
            InvoiceStatus.Refunded => "violet",
            InvoiceStatus.PartlyRefundet => "purple",
            _ => "black"
        };
    }

    private static string GetText(
        InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Open => "Offen",
            InvoiceStatus.Reminder => "Mahnung",
            InvoiceStatus.Paid => "Bezahlt",
            InvoiceStatus.Refunded => "Zurückerstattet",
            InvoiceStatus.PartlyRefundet =>
                "Teilweise zurückerstattet",
            _ => "-"
        };
    }
}
```

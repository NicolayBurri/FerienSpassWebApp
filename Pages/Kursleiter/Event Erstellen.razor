@page "/kursleiter/event-erstellen"

@using FerienspassWebApp.Models
@using FerienspassWebApp.Data
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager

@attribute [Authorize(Roles = "Admin,Kursleiter")]

<PageTitle>Event Erstellen</PageTitle>

<div style="display:flex; flex-direction:column; gap:8px; max-width:500px;">

    <input placeholder="Eventname" @bind="ev.Eventname" />
    <input placeholder="Location" @bind="ev.Location" />
    <input placeholder="Treffpunkt" @bind="ev.Treffpunkt" />
    <label>Kategorie</label>
    <select @bind="ev.Kategorie">
        @foreach (var k in Enum.GetValues<EventKategorie>())
        {
            <option value="@k">@k</option>
        }
    </select>

    <label>Kursleiter / Admins</label>

    <div style="
    border:1px solid #ccc;
    padding:10px;
    border-radius:8px;
    display:flex;
    flex-direction:column;
    gap:6px;">

        @foreach (var u in users)
        {
            <label style="display:flex; gap:8px; align-items:center;">

                <input type="checkbox"
                       checked="@selectedUserIds.Contains(u.Id)"
                       @onchange="e => ToggleUser(u.Id, (bool)e.Value!)" />

                @u.UserName

            </label>
        }
    </div>
    

    <hr/>

    <p>Maximal anzahl Kinder</p>
    <input type="number" placeholder="Max Kinder" @bind="ev.MaxKinder" />

    <p>Minimum anzahl Kinder</p>
    <input type="number" placeholder="Min Kinder" @bind="ev.MinKinder" />

    <p>Preis</p>
    <input type="number" placeholder="Preis" @bind="ev.price" />

    <hr />

    <label>
        <input type="checkbox" @bind="ev.BrauchtBetreuung" />
        Zusätzliche Betreuung erforderlich
    </label>

    @if (ev.BrauchtBetreuung)
    {
        <input type="number" placeholder="Anzahl Betreuungspersonen" @bind="ev.AnzahlBetreuung" />
    }

    <label>
        <input type="checkbox" @bind="ev.BrauchtFahrer" />
        Fahrer Notwendig
    </label>

    @if (ev.BrauchtFahrer)
    {
        <input type="number" placeholder="Anzahl Sitzplätze für Autfahrt" @bind="ev.AnzahlSitzplaetze" />
    }

    <hr />

    <label>Mindestklasse</label>
    <select @bind="ev.KlasseMin">
        <option value="">Keine Einschränkung</option>
        @foreach (var k in Enum.GetValues<KlasseStufe>())
            {
            <option value="@k">@k</option>
        }
    </select>

    <label>Maximalklasse</label>
    <select @bind="ev.KlasseMax">
        <option value="">Keine Einschränkung</option>
        @foreach (var k in Enum.GetValues<KlasseStufe>())
        {
            <option value="@k">@k</option>
        }
    </select>

    <hr />

    <input type="datetime-local" value="@ev.StartZeit?.ToString("yyyy-MM-ddTHH:mm")"
           @onchange="e => ev.StartZeit = DateTime.Parse(e.Value.ToString())" />

    <input type="datetime-local" value="@ev.EndeZeit?.ToString("yyyy-MM-ddTHH:mm")"
           @onchange="e => ev.EndeZeit = DateTime.Parse(e.Value.ToString())" />

    <hr />

    <div style="border:2px dashed #ccc; padding:20px; text-align:center;">
        <p>Bild hier hineinziehen oder klicken</p>
        <InputFile OnChange="HandleFileUpload" 
            accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
    </div>

    @if (!string.IsNullOrEmpty(ev.BildUrl))
    {
        <p>Vorschau:</p>
        <img src="@ev.BildUrl" style="max-width:200px;" />
    }

    <hr />

    <textarea placeholder="Beschreibung" @bind="ev.Beschreibung"></textarea>

    <hr />

    <div style="border:2px dashed #ccc; padding:20px; text-align:center;">
        <p>Dokument hier hineinziehen oder klicken</p>
        <InputFile OnChange="HandleDocUpload" />
    </div>

    @if (!string.IsNullOrEmpty(ev.DocumentUrl))
    {
        <p>Dokument:</p>
        <a href="@ev.DocumentUrl" target="_blank">Dokument öffnen</a>
    }


    <button @onclick="Save">Speichern</button>

    @if (!string.IsNullOrEmpty(msg))
    {
        <p style="color:green">@msg</p>
    }

</div>

@code {
    private Event ev = new();
    private string? msg;

    private List<ApplicationUser> users = new();
    private List<string> selectedUserIds = new();

    protected override async Task OnInitializedAsync()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();

        users = await (
            from user in Db.Users
            join userRole in Db.UserRoles on user.Id equals userRole.UserId
            join role in Db.Roles on userRole.RoleId equals role.Id
            where role.Name == "Admin" || role.Name == "Kursleiter"
            select user
        )
        .Distinct()
        .ToListAsync();
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
            return;

        if (!file.ContentType.StartsWith("image/"))
        {
            msg = "Nur Bilder Erlaubt!";
            return;
        }

        var folderPath = Path.Combine("wwwroot", "images", "events");

        if (!Directory.Exists(folderPath))
            Directory.CreateDirectory(folderPath);

        var safeName = (ev.Eventname ?? "event").Replace(" ", "_");

        var fileName = $"{safeName}_{DateTime.Now.Ticks}{Path.GetExtension(file.Name)}";

        var fullPath = Path.Combine(folderPath, fileName);

        using (var stream = new FileStream(fullPath, FileMode.Create))
        {
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream); // max 5MB
        }

        ev.BildUrl = $"images/events/{fileName}";
    }

    private async Task HandleDocUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
            return;

        var allowedContentTypes = new[]{
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        };

        var allowedExtensions = new[]
        {
            ".pdf",
            ".doc",
            ".docx"
        };

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedContentTypes.Contains(file.ContentType) ||
            !allowedExtensions.Contains(extension))
        {
            msg = "Nur PDF- oder Word-Dateien erlaubt!";
            return;
        }

        var folderPath = Path.Combine("wwwroot", "docs", "events");

        if (!Directory.Exists(folderPath))
            Directory.CreateDirectory(folderPath);

        var safeName = (ev.Eventname ?? "event").Replace(" ", "_");

        var fileName = $"{safeName}_{DateTime.Now.Ticks}{extension}";

        var fullPath = Path.Combine(folderPath, fileName);

        using (var stream = new FileStream(fullPath, FileMode.Create))
        {
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream); // max 5MB
        }

        ev.DocumentUrl = $"docs/events/{fileName}";
        msg = "Dokument hochgeladen!";
    }



    private async Task<List<string>> CheckKursleiterConflicts()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var conflictingUsers = new List<string>();

        foreach (var userId in selectedUserIds)
        {
            bool hasConflict = await Db.EventKursleiter
                .Include(x => x.Event)
                .AnyAsync(x =>
                    x.UserId == userId &&

                    // anderes Event
                    x.Event.Id != ev.Id &&

                    // Zeit überschneidet sich
                    ev.StartZeit < x.Event.EndeZeit &&
                    ev.EndeZeit > x.Event.StartZeit
                );

            if (hasConflict)
            {
                var user = await Db.Users.FirstOrDefaultAsync(x => x.Id == userId);

                if (user != null)
                {
                    conflictingUsers.Add(user.UserName!);
                }
            }
        }

        return conflictingUsers;
    }

    private void ToggleUser(string userId, bool isChecked)
    {
        if (isChecked)
        {
            if (!selectedUserIds.Contains(userId))
            {
                selectedUserIds.Add(userId);
            }
        }
        else
        {
            selectedUserIds.Remove(userId);
        }
    }

    async Task Save()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var conflicts = await CheckKursleiterConflicts();

        if (ev.KlasseMin.HasValue && ev.KlasseMax.HasValue && ev.KlasseMin > ev.KlasseMax)
            {
                msg = "Mindestklasse darf nicht höher sein als Maximalklasse?";
                return;
            }

        if (conflicts.Any())
        {
            msg = "Konflikt bei: " + string.Join(", ", conflicts);
            return;
        }

        Db.Events.Add(ev);
        await Db.SaveChangesAsync();

        foreach (var userId in selectedUserIds)
        {
            Db.EventKursleiter.Add(new EventKursleiter
                {
                    EventId = ev.Id,
                    UserId = userId
                });
        }

        await Db.SaveChangesAsync();

        ev = new Event();
        selectedUserIds.Clear();

        msg = "Event gespeichert!";
    }
}

@page "/kursleiter/events/edit/{eventId:int}"

@using FerienspassWebApp.Data
@using FerienspassWebApp.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin,Kursleiter")]

@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<h3>Event bearbeiten</h3>

@if (ev == null)
{
    <p>Lade...</p>
}
else
{
    <div style="display:flex; flex-direction:column; gap:10px; max-width:600px;">

        <input @bind="ev.Eventname" placeholder="Eventname" />

        <select @bind="ev.Kategorie">
            <option value="@EventKategorie.Tier">Tiere</option>
            <option value="@EventKategorie.Food">Essen</option>
            <option value="@EventKategorie.Erlebnis">Erlebnis</option>
            <option value="@EventKategorie.Kreativ">Kreativ</option>
            <option value="@EventKategorie.Sport">Sport</option>
            <option value="@EventKategorie.Vaki">Vaki</option>
            <option value="@EventKategorie.Allgemein">Allgemein</option>
        </select>

        <h4>Kursleiter</h4>

        @foreach (var kl in kursleiter)
        {
            <div @key="kl" style="display:flex; gap:10px; align-items:center;">
                <select @bind="kl.UserId">
                    @foreach (var u in users)
                    {
                        <option value="@u.Id">
                            @u.Vorname @u.Nachname
                        </option>
                    }
                </select>

                <button @onclick="() => RemoveKursleiter(kl)">
                    Entfernen
                </button>
            </div>
        }

        <button @onclick="AddKursleiter">
            + Kursleiter hinzufügen
        </button>

        <p style="margin:0px;">Beschreibung:</p>
        <textarea @bind="ev.Beschreibung"
                    placeholder="Beschreibung">
            </textarea>

        <p style="margin:0px;">Location:</p>
        <input @bind="ev.Location"
               placeholder="Ort" />

        <p style="margin:0px;">Treffpunkt:</p>
        <input @bind="ev.Treffpunkt"
               placeholder="Treffpunkt" />

        <p style="margin:0px;">Preis in CHF:</p>
        <input type="number"
               @bind="ev.price"
               placeholder="Preis" />

        <p style="margin:0px;">Mindestanzahl an Kinder:</p>
        <input type="number"
               @bind="ev.MinKinder"
               placeholder="Min Kinder" />

        <p style="margin:0px;">Maximalanzahl an Kinder:</p>
        <input type="number"
               @bind="ev.MaxKinder"
               placeholder="Max Kinder" />

        <p style="margin:0px;">Warteliste Limit:</p>
        <input type="number"
               @bind="ev.WaitlisteLimit"
               placeholder="Warteliste Limit" />

        <p style="margin:0px;">Mindestklasse:</p>
        <select @bind="ev.KlasseMin">
            <option value="">Keine Einschränkung</option>
            @foreach (var k in Enum.GetValues<KlasseStufe>())
            {
                <option value="@k">@k</option>
            }
        </select>

        <p style="margin:0px;">Maximalklasse:</p>
        <select @bind="ev.KlasseMax">
            <option value="">Keine Einschränkung</option>
            @foreach (var k in Enum.GetValues<KlasseStufe>())
            {
                <option value="@k">@k</option>
            }
        </select>

        <label>
            <input type="checkbox"
                   @bind="ev.BrauchtBetreuung" />
            Braucht Betreuung
        </label>

        @if (ev.BrauchtBetreuung)
        {
            <input type="number"
                   @bind="ev.AnzahlBetreuung"
                   placeholder="Anzahl Betreuung" />
        }

        <label>
            <input type="checkbox"
                   @bind="ev.BrauchtFahrer" />
            Braucht Fahrer
        </label>

        @if (ev.BrauchtFahrer)
        {
            <input type="number"
                   @bind="ev.AnzahlSitzplaetze"
                   placeholder="Benötigte Sitzplätze" />
        }

        <label>Start</label>

        <input type="datetime-local"
               value="@startText"
               @onchange="e => startText = e.Value?.ToString()" />

        <label>Ende</label>

        <input type="datetime-local"
               value="@endText"
               @onchange="e => endText = e.Value?.ToString()" />

        <label>Bild</label>

        @if (!string.IsNullOrEmpty(ev.BildUrl))
        {
            <p>Aktuelles Bild:</p>
            <img src="/@ev.BildUrl" style="max-width:200px;" />
        }

        <div style="border:2px dashed #ccc; padding:20px; text-align:center;">
            <p>Neues Bild hochladen</p>
            <InputFile OnChange="HandleFileUpload"
                       accept="image/*" />
        </div>

        <label>Dokument</label>
        @if (!string.IsNullOrEmpty(ev.DocumentUrl))
        {
            <p>Aktuelles Dokument:</p>
            <a href="/@ev.DocumentUrl" target="_blank">Dokument öffnen</a>
        }

        <div style="border:2px dashed #ccc; padding:20px; text-align:center;">
            <p>Neues Dokument hochladen</p>
            <InputFile OnChange="HandleDocUpload"
                  accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
        </div>

        <label>
            <input type="checkbox"
                   @bind="ev.IsArchived" />
            Event archivieren
        </label>

        <br />

        <div style="display:flex; gap:10px;">

            <button class="btn btn-primary"
                    @onclick="Save">
                Speichern
            </button>

            <button class="btn btn-warning"
                    @onclick="CopyEvent">
                Event kopieren
            </button>

            <button class="btn btn-danger" @onclick="() => DeleteEvent(ev)">
                Löschen
            </button>

        </div>

        <p>@msg</p>

    </div>
}

@code {
    [Parameter] public int eventId { get; set; }

    private Event? ev;

    private string? startText;
    private string? endText;

    private string? msg;

    private List<EventKursleiter> kursleiter = new();
    private List<ApplicationUser> users = new();

    protected override async Task OnInitializedAsync()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        ev = await Db.Events.FirstOrDefaultAsync(x => x.Id == eventId);

        if (ev != null)
        {
            startText = ev.StartZeit?.ToString("yyyy-MM-ddTHH:mm");
            endText = ev.EndeZeit?.ToString("yyyy-MM-ddTHH:mm");
        }

        kursleiter = await Db.EventKursleiter
            .Include(x => x.User)
            .Where(x => x.EventId == eventId)
            .ToListAsync();

        users = await Db.Users.ToListAsync();
    }

    async Task Save()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();

        if (ev == null)
            return;

        var dbEvent = await Db.Events
            .FirstOrDefaultAsync(x => x.Id == ev.Id);

        if (dbEvent == null)
        {
            msg = "Event nicht gefunden.";
            return;
        }

        if (ev.KlasseMin.HasValue && ev.KlasseMax.HasValue && ev.KlasseMin > ev.KlasseMax)
        {
            msg = "Mindestklasse darf nicht höher sein als Maximalklasse.";
            return;
        }

        dbEvent.Eventname = ev.Eventname;
        dbEvent.Kategorie = ev.Kategorie;
        dbEvent.Beschreibung = ev.Beschreibung;
        dbEvent.Location = ev.Location;
        dbEvent.Treffpunkt = ev.Treffpunkt;
        dbEvent.price = ev.price;
        dbEvent.MinKinder = ev.MinKinder;
        dbEvent.MaxKinder = ev.MaxKinder;
        dbEvent.WaitlisteLimit = ev.WaitlisteLimit;
        dbEvent.KlasseMin = ev.KlasseMin;
        dbEvent.KlasseMax = ev.KlasseMax;
        dbEvent.BrauchtBetreuung = ev.BrauchtBetreuung;
        dbEvent.AnzahlBetreuung = ev.AnzahlBetreuung;
        dbEvent.BrauchtFahrer = ev.BrauchtFahrer;
        dbEvent.AnzahlSitzplaetze = ev.AnzahlSitzplaetze;
        dbEvent.BildUrl = ev.BildUrl;
        dbEvent.DocumentUrl = ev.DocumentUrl;
        dbEvent.IsArchived = ev.IsArchived;

        if (DateTime.TryParse(startText, out var s))
            dbEvent.StartZeit = s;

        if (DateTime.TryParse(endText, out var e))
            dbEvent.EndeZeit = e;

        var oldKursleiter = await Db.EventKursleiter
            .Where(x => x.EventId == dbEvent.Id)
            .ToListAsync();

        Db.EventKursleiter.RemoveRange(oldKursleiter);

        foreach (var kl in kursleiter)
        {
            if (!string.IsNullOrEmpty(kl.UserId))
            {
                Db.EventKursleiter.Add(new EventKursleiter
                    {
                        EventId = dbEvent.Id,
                        UserId = kl.UserId
                    });
            }
        }

        await Db.SaveChangesAsync();

        ev = dbEvent;

        msg = "Gespeichert!";
    }

    async Task CopyEvent()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        if (ev == null)
            return;

        var newEvent = new Event
            {
                Eventname = ev.Eventname + "(Kopie)",

                Kategorie = ev.Kategorie,

                Beschreibung = ev.Beschreibung,

                Location = ev.Location,

                Treffpunkt = ev.Treffpunkt,

                price = ev.price,

                MaxKinder = ev.MaxKinder,

                MinKinder = ev.MinKinder,

                WaitlisteLimit = ev.WaitlisteLimit,

                BrauchtBetreuung = ev.BrauchtBetreuung,

                AnzahlBetreuung = ev.AnzahlBetreuung,

                BrauchtFahrer = ev.BrauchtFahrer,

                AnzahlSitzplaetze = ev.AnzahlSitzplaetze,

                KlasseMin = ev.KlasseMin,

                KlasseMax = ev.KlasseMax,

                BildUrl = ev.BildUrl,

                DocumentUrl = ev.DocumentUrl,

                StartZeit = null,

                EndeZeit = null,

                IsArchived = false,

                CopiedFromEventId = ev.Id
            };

        Db.Events.Add(newEvent);

        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/kursleiter/events/edit/{newEvent.Id}");
    }

    async Task DeleteEvent(Event ev)
    {
        await using var Db = await DbFactory.CreateDbContextAsync();

        var dbEvent = await Db.Events
            .FirstOrDefaultAsync(x => x.Id == ev.Id);

        if (dbEvent == null)
        {
            msg = "Event nicht gefunden.";
            return;
        }

        dbEvent.IsDeleted = true;

        var kursleiter = await Db.EventKursleiter
            .Where(x => x.EventId == dbEvent.Id)
            .ToListAsync();

        Db.EventKursleiter.RemoveRange(kursleiter);

        await Db.SaveChangesAsync();

        Nav.NavigateTo("/kursleiter/events");
    }

    void AddKursleiter()
    {
        var firstUser = users.FirstOrDefault();

        if (firstUser == null)
        {
            msg = "Keine Benutzer vorhanden.";
            return;
        }

        kursleiter.Add(new EventKursleiter
            {
                EventId = eventId,
                UserId = firstUser.Id
            });
    }

    async Task RemoveKursleiter(EventKursleiter kl)
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        kursleiter.Remove(kl);
        Db.EventKursleiter.Remove(kl);
        await Db.SaveChangesAsync();
    }

    private async Task HandleDocUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
            return;

        var allowedContentTypes = new[]
        {
        "application/pdf",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    };

        var allowedExtensions = new[]
        {
        ".pdf",
        ".doc",
        ".docx"
    };

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedContentTypes.Contains(file.ContentType) ||
            !allowedExtensions.Contains(extension))
        {
            msg = "Nur PDF- oder Word-Dateien erlaubt!";
            return;
        }

        var folderPath = Path.Combine("wwwroot", "docs", "events");

        if (!Directory.Exists(folderPath))
            Directory.CreateDirectory(folderPath);

        var safeName = (ev?.Eventname ?? "event").Replace(" ", "_");

        var fileName = $"{safeName}_{DateTime.Now.Ticks}{extension}";
        var fullPath = Path.Combine(folderPath, fileName);

        using (var stream = new FileStream(fullPath, FileMode.Create))
        {
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream);
        }

        if (ev != null)
        {
            ev.DocumentUrl = $"docs/events/{fileName}";
            msg = "Dokument hochgeladen! Zum speichern bitte speichern drücken.";
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
            return;

        if (!file.ContentType.StartsWith("image/"))
        {
            msg = "Nur Bilder erlaubt!";
            return;
        }

        var folderPath = Path.Combine("wwwroot", "images", "events");

        if (!Directory.Exists(folderPath))
            Directory.CreateDirectory(folderPath);

        var safeName = (ev?.Eventname ?? "event").Replace(" ", "_");

        var fileName = $"{safeName}_{DateTime.Now.Ticks}{Path.GetExtension(file.Name)}";

        var fullPath = Path.Combine(folderPath, fileName);

        using (var stream = new FileStream(fullPath, FileMode.Create))
        {
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream);
        }

        if (ev != null)
        {
            ev.BildUrl = $"images/events/{fileName}";
            msg = "Bild hochgeladen! Zum Speichern bitte speichern drücken.";
        }
    }
}
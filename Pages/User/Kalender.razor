@page "/user/Kalender"

@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IDbContextFactory<ApplicationDbContext> DbFactory

@using FerienspassWebApp.Data
@using FerienspassWebApp.Models
@using Microsoft.EntityFrameworkCore
@using ClosedXML.Excel
@using System.IO
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin,Kursleiter,Eltern")]

<PageTitle>Event Kalender</PageTitle>

<h1>Event Liste</h1>

@if (isLoading)
{
    <p>Momentan sind keine Events geplant.</p>
}
else if (myChildIds.Count == 0)
{
    <p>Bitte zuerst Kinder, Nutzerdaten und Notfallkontakte erfassen.</p>
}
else
{
    <AuthorizeView Roles="Admin,Kursleiter">
        <Authorized>

            <button class="btn btn-success"
                    @onclick="ExportEventsExcel">
                Events als Excel exportieren
            </button>

            <br />
            <br />

        </Authorized>
    </AuthorizeView>

    <div class="filter-bar">
        <h4>Filter: </h4>
        <select value="@selectedKategorie"
            @onchange="OnKategorieChanged">
            <option value="">Alle Kategorien</option>
            <option value="@EventKategorie.Tier">Tiere</option>
            <option value="@EventKategorie.Food">Essen</option>
            <option value="@EventKategorie.Erlebnis">Erlebnis</option>
            <option value="@EventKategorie.Kreativ">Kreativ</option>
            <option value="@EventKategorie.Sport">Sport</option>
            <option value="@EventKategorie.Vaki">Vaki</option>
            <option value="@EventKategorie.Allgemein">Allgemein</option>
        </select>

        <input type="number" value="@filterAlter" @oninput="OnAlterChanged" placeholder="Alter"/>

        <button class="btn btn-sm btn-dark" @onclick="ToggleDateFilter">Datum</button>

        @if (showDateFilter)
        {
            <input type="date" @bind="filterDatum" @bind:after="LoadEvents" />
        }

    </div>

    <br />
    <br />

    @if (!days.Any())
    {
        <p>Keine Events gefunden.</p>
    }
    else
    {
        <div style="margin-bottom:20px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">

            <button class="btn btn-secondary"
                    disabled="@(currentDayIndex == 0)"
                    @onclick="PreviousDay">
                ← Vorheriger Tag
            </button>

            @for (int i = 0; i < days.Count; i++)
            {
                var index = i;

                <button class="btn @(currentDayIndex == index ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => GoToDay(index)">
                    @days[index].ToString("dd.MM")
                </button>
            }

            <button class="btn btn-secondary"
                    disabled="@(currentDayIndex == days.Count - 1)"
                    @onclick="NextDay">
                Nächster Tag →
            </button>

        </div>

        <h2>@selectedDay?.ToString("dddd dd.MM.yyyy")</h2>

        @foreach (var ev in eventsToday)
        {
            <div style="border:1px solid #ccc; padding:8px; margin-bottom:5px; display:flex; align-items:flex-start;">

                <div style="flex:auto;">

                    <h3>Event: @ev.Eventname</h3><br />

                    <div style="white-space: pre-line;">
                        @ev.Beschreibung
                    </div>

                    <p>
                        <strong>Zeit:</strong>
                        @ev.StartZeit?.ToString("HH:mm") - @ev.EndeZeit?.ToString("HH:mm")
                    </p>

                    <p><strong>Kategorie:</strong> @ev.Kategorie</p>

                    <p><strong>Treffpunkt</strong> @ev.Treffpunkt</p>

                    <p><strong>Veranstaltungsort:</strong> @ev.Location</p>

                    <p><strong>Preis:</strong> @ev.price CHF</p>

                    <p>
                        <strong>Mindest- und Maximalkapazität:</strong>
                        @ev.MinKinder - @ev.MaxKinder Kinder
                    </p>

                    @if (availabilityByEvent.TryGetValue(ev.Id, out var av))
                    {
                        @if (av.FreiePlaetze > 0)
                        {
                            <p style="color:green">
                                Noch @av.FreiePlaetze Plätze verfügbar
                            </p>
                        }
                        else if (av.FreieWartelistePlaetze > 0)
                        {
                            <p style="color:orange">
                                Event voll – noch @av.FreieWartelistePlaetze Wartelisteplätze verfügbar
                            </p>
                        }
                        else
                        {
                            <p style="color:red">
                                AUSGEBUCHT
                            </p>
                        }
                    }

                    <p>
                        <strong>Klassenbeschränkung: </strong>
                        @ev.KlasseMin - @ev.KlasseMax
                    </p>

                    <h4>Kursleiter</h4>

                    @if (ev.Kursleiter?.Any() == true)
                    {
                        @foreach (var kl in ev.Kursleiter)
                        {
                            <p>@kl.User?.Vorname @kl.User?.Nachname</p>
                        }
                    }
                    else
                    {
                        <p>Es ist noch kein Kursleiter definiert.</p>
                    }

                    <button class="btn btn-sm btn-primary"
                            @onclick="() => GoToEvent(ev.Id)"
                            disabled="@ev.IsFull">
                        @(ev.IsFull ? "Ausgebucht" : "Anmelden")
                    </button>

                    @if (myRegsByEvent.TryGetValue(ev.Id, out var myRegs) && myRegs.Any())
                    {
                        <div style="margin-top:8px;">
                            <b>Meine Kinder:</b>

                            <ul>
                                @foreach (var r in myRegs)
                                {
                                    <li>
                                        <div style="display:flex; gap:20px;">
                                            <p>Kind:</p>

                                            @r.Child.Name

                                            <p>-</p>

                                            <p>Status:</p>

                                            @if (r.Status == EnrollmentStatus.Confirmed)
                                            {
                                                <span style="color:green">Bestätigt</span>
                                            }
                                            else
                                            {
                                                <span style="color:orange">Warteliste</span>
                                            }

                                            <button style="max-height:30px; font-size:14px; line-height:5px;"
                                                    class="btn btn-warning"
                                                    @onclick="() => UnregisterChild(ev.Id, r.ChildId)">
                                                Abmelden
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (myRolesByEvent.TryGetValue(ev.Id, out var roles) && roles.Any())
                    {
                        <div style="margin-top:8px;">
                            <b>Meine Rollen:</b>

                            <ul>
                                @foreach (var r in roles)
                                {
                                    <li>
                                        <div style="display:flex; gap:20px;">
                                            @if (r.Role == RoleType.Driver)
                                            {
                                                <span>Fahrer</span>

                                                @if (r.Seats.HasValue)
                                                {
                                                    <span> (@r.Seats Plätze)</span>
                                                }
                                            }
                                            else if (r.Role == RoleType.Helper)
                                            {
                                                <span>Betreuungsperson</span>
                                            }

                                            <button style="height:30px; font-size:15px; line-height:5px;"
                                                    class="btn btn-warning"
                                                    @onclick="() => UnregisterRole(r.Id)">
                                                Abmelden
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(ev.BildUrl))
                {
                    <img src="@ev.BildUrl"
                         style="width:600px;
                            max-height:500px;
                            object-fit:cover;
                            border-radius:10px;" />
                }
            </div>
        }
    }
}

@code {

    private bool isLoading = true;
    private bool showDateFilter = false;
    private DateTime? filterDatum;
    private int currentDayIndex = 0;

    private List<Event> events = new();
    private List<DateTime> days = new();


    private Dictionary<DateTime, List<Event>> eventsByDay = new();
    private Dictionary<int, List<EventRoleAssignment>> myRolesByEvent = new();
    private Dictionary<int, EventAvailability> availabilityByEvent = new();

    private EventKategorie? selectedKategorie;
    private int? filterAlter;

    private Dictionary<int, List<EventChild>> myRegsByEvent = new();

    private string? userId;
    private List<int> myChildIds = new();


    private class EventAvailability
    {
        public int FreiePlaetze { get; set; }
        public int FreieWartelistePlaetze { get; set; }
    }

    private DateTime? selectedDay =>
        days.Any() ? days[currentDayIndex] : null;

    private List<Event> eventsToday =>
        selectedDay == null
        ? new List<Event>()
        : events
            .Where(e => e.StartZeit.HasValue &&
                    e.StartZeit.Value.Date == selectedDay.Value.Date)
            .OrderBy(e => e.StartZeit)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
                return;

            // nur eigene Kinder
            myChildIds = await Db.Children
                .AsNoTracking()
                .Where(c => c.ParentUserId == userId)
                .Select(c => c.Id)
                .ToListAsync();
            // hier überprüfen, ob der Nuter die Daten, die Notfallkontakte schon erfasst hat.


            await LoadEvents();
            await LoadMyRegistrations();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadEvents()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var query = Db.Events
            .AsNoTracking()
            .Include(x => x.Kursleiter)
                .ThenInclude(x => x.User)
            .Where(x => !x.IsDeleted)
            .Where(x => x.StartZeit >= DateTime.Now);

        if (selectedKategorie.HasValue)
        {
            query = query.Where(x => x.Kategorie == selectedKategorie);
        }

        if (filterAlter.HasValue)
        {
            query = query.Where(x =>
                (!x.AlterMin.HasValue || x.AlterMin <= filterAlter) &&
                (!x.AlterMax.HasValue || x.AlterMax >= filterAlter));
        }

        if (filterDatum.HasValue)
        {
            var date = filterDatum.Value.Date;

            query = query.Where(x =>
                x.StartZeit.HasValue &&
                x.StartZeit.Value.Date == date);
        }

        var result = await query
            .OrderBy(x => x.StartZeit)
            .ToListAsync();

        events = result;

        var eventIds = events.Select(e => e.Id).ToList();

        var counts = await Db.EventChildren
            .AsNoTracking()
            .Where(x => eventIds.Contains(x.EventId))
            .GroupBy(x => x.EventId)
            .Select(g => new
            {
                EventId = g.Key,
                Confirmed = g.Count(x => x.Status == EnrollmentStatus.Confirmed),
                Waiting = g.Count(x => x.Status == EnrollmentStatus.WaitingList)
            })
            .ToListAsync();

        availabilityByEvent = events.ToDictionary(ev => ev.Id, ev =>
        {
            var c = counts.FirstOrDefault(x => x.EventId == ev.Id);

            var confirmed = c?.Confirmed ?? 0;
            var waiting = c?.Waiting ?? 0;

            return new EventAvailability
                {
                    FreiePlaetze = Math.Max(0, ev.MaxKinder - confirmed),
                    FreieWartelistePlaetze = Math.Max(0, ev.WaitlisteLimit - waiting)
                };
        });

        days = events
            .Where(x => x.StartZeit.HasValue)
            .Select(x => x.StartZeit!.Value.Date)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        if (currentDayIndex >= days.Count)
        {
            currentDayIndex = 0;
        }
    }

    private async Task LoadMyRegistrations()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var allRegs = await Db.EventChildren
            .AsNoTracking()
            .Include(x => x.Child)
            .Where(x => myChildIds.Contains(x.ChildId))
            .ToListAsync();

        myRegsByEvent = allRegs
            .GroupBy(x => x.EventId)
            .ToDictionary(g => g.Key, g => g.ToList());

        var myRoles = await Db.EventRoleAssignments
            .AsNoTracking()
            .Where(x => x.UserId == userId)
            .ToListAsync();

        myRolesByEvent = myRoles
            .GroupBy(x => x.EventId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    void GoToEvent(int id)
    {
        Nav.NavigateTo($"/user/anmelden/{id}");
    }

    async Task UnregisterChild(int eventId, int childId)
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var entry = await Db.EventChildren
            .FirstOrDefaultAsync(x =>
                x.EventId == eventId &&
                x.ChildId == childId);

        if (entry == null)
            return;

        Db.EventChildren.Remove(entry);
        await Db.SaveChangesAsync();

        await PromoteWaitingList(eventId);
        await LoadMyRegistrations();
    }

    async Task PromoteWaitingList(int eventId)
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var ev = await Db.Events
            .FirstAsync(x => x.Id == eventId);

        var confirmedCount = await Db.EventChildren
            .CountAsync(x =>
                x.EventId == eventId &&
                x.Status == EnrollmentStatus.Confirmed);

        var waiting = await Db.EventChildren
            .Where(x =>
                x.EventId == eventId &&
                x.Status == EnrollmentStatus.WaitingList)
            .OrderBy(x => x.RegisteredAt)
            .ToListAsync();

        int freeSlots = ev.MaxKinder - confirmedCount;

        if (freeSlots <= 0)
            return;

        foreach (var entry in waiting.Take(freeSlots))
        {
            entry.Status = EnrollmentStatus.Confirmed;
        }

        await Db.SaveChangesAsync();
    }

    private async Task OnKategorieChanged(ChangeEventArgs e)
    {
        selectedKategorie = string.IsNullOrEmpty(e.Value?.ToString())
            ? null
            : Enum.Parse<EventKategorie>(e.Value!.ToString()!);

        await LoadEvents();
    }

    private async Task OnAlterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            filterAlter = val;
        else
            filterAlter = null;

        await LoadEvents();
    }

    async Task ExportEventsExcel()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var currentYear = DateTime.Now.Year;

        var allEvents = await Db.Events
            .Include(x => x.Kursleiter)
                .ThenInclude(x => x.User)
            .Where(x => x.StartZeit.HasValue &&
                        x.StartZeit.Value.Year == currentYear)
            .OrderBy(x => x.StartZeit)
            .ToListAsync();

        using var workbook = new XLWorkbook();

        var ws = workbook.AddWorksheet("Events");

        //Header
        ws.Cell(1, 1).Value = "Datum";
        ws.Cell(1, 2).Value = "Start";
        ws.Cell(1, 3).Value = "Ende";
        ws.Cell(1, 4).Value = "Event";
        ws.Cell(1, 5).Value = "Kategorie";
        ws.Cell(1, 6).Value = "Ort";
        ws.Cell(1, 7).Value = "Kursleiter";

        int row = 2;

        foreach (var ev in allEvents){
            var kursleiterNames = ev.Kursleiter.Any()
                ? string.Join(", ",
                ev.Kursleiter
                    .Select(k => k.User.Vorname))
                : "-";

            ws.Cell(row, 1).Value = ev.StartZeit?.ToString("dd.MM.yyyy");

            ws.Cell(row, 2).Value = ev.StartZeit?.ToString("HH:mm");

            ws.Cell(row, 3).Value = ev.EndeZeit?.ToString("HH:mm");

            ws.Cell(row, 4).Value = ev.Eventname;

            ws.Cell(row, 5).Value = ev.Kategorie.ToString();

            ws.Cell(row, 6).Value = ev.Location;

            ws.Cell(row, 7).Value = kursleiterNames;


            row++;

        }

        ws.Columns().AdjustToContents();

        using var stream = new MemoryStream();

        workbook.SaveAs(stream);

        stream.Position = 0;

        using var streamRef = new DotNetStreamReference(stream);

        await JS.InvokeVoidAsync(
            "downloadFileFromStream",
            "Events.xlsx",
            streamRef
        );


    }

    async Task UnregisterRole(int roleId)
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var entry = await Db.EventRoleAssignments
            .FirstOrDefaultAsync(x => x.Id == roleId);

        if (entry == null)
            return;

        Db.EventRoleAssignments.Remove(entry);
        await Db.SaveChangesAsync();

        await LoadMyRegistrations();
    }

    async Task ToggleDateFilter()
    {
        showDateFilter = !showDateFilter;
        

        if (!showDateFilter)
        {
            filterDatum = null;
        }

        await LoadEvents();
    }

    private void NextDay()
    {
        if (currentDayIndex < days.Count - 1)
        {
            currentDayIndex++;
        }
    }

    private void PreviousDay()
    {
        if (currentDayIndex > 0)
        {
            currentDayIndex--;
        }
    }

    private void GoToDay(int index)
    {
        if (index >= 0 && index < days.Count)
        {
            currentDayIndex = index;
        }
    }
}
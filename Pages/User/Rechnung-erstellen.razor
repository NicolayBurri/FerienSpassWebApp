@page "/user/rechnung-erstellen"

@using Microsoft.EntityFrameworkCore
@using Codecrete.SwissQRBill.Generator
@using PdfSharpCore.Pdf
@using PdfSharpCore.Drawing
@using FerienspassWebApp.Models
@using FerienspassWebApp.Data
@using SkiaSharp
@using Svg.Skia
@using System.IO
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "Admin,Kursleiter,Eltern")]


@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Env

<h3>Rechnung Erstellen</h3>

@if (isLoading)
{
    <p>Laden...</p>
}
else if (!items.Any())
{
    <p>Keine offenen Buchungen vorhanden, Rechnungen wurden schon erstellt.</p>
}
else
{
    <h4>Offene Positionen</h4>

    <ul>
        @foreach (var i in items)
        {
            <li>
                @i.Child.Name - @i.Event.Eventname - CHF @i.Event.price
            </li>
        }
    </ul>

    <hr />

    <h3>Total: CHF @total</h3>

    <button class="btn btn-primary" @onclick="CreateInvoice">
        Rechnung erstellen
    </button>

    <hr />

    <h4>QR Rechnung</h4>

    @if (!string.IsNullOrEmpty(qrSvg))
    {
        <p><b>Referenz:</b> @referenceNumber</p>
        <p><b>Total:</b> CHF @total</p>

        <div>
            @((MarkupString)qrSvg)
        </div>
        <a class="btn btn-primary"
           href="@($"/api/invoices/{invoiceID}/download")"
           target="_blank">
            PDF herunterladen
        </a>

        <hr />

        <h4>TWINT</h4>

        <a class="btn btn-success"
           href="@GetTwintUrl()"
           target="_blank">
            Direkt bezahlen
        </a>
    }

    
}

@code {
    private string? userId;
    private int? invoiceID;
    private List<EventChild> items = new();
    private decimal total;
    private bool isLoading = true;

    private string? referenceNumber;
    private string? pdfFileName;
    private string? qrSvg;

    private Invoice? createdInvoice;

    private const string IBAN = "CH9206450600189814504";
    private const string CreditorName = "Ferienspass Rohrbach";
    private const string CreditorStreet = "Auswil und Rohrbachgraben";
    private const string CreditorCity = "4938 Rohrbach";

    protected override async Task OnInitializedAsync()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        items = await Db.EventChildren
            .Include(x => x.Event)
            .Include(x => x.Child)
            .Where(x =>
                x.Child.ParentUserId == userId &&
                !x.IsInvoiced &&
                x.Status == EnrollmentStatus.Confirmed)
            .ToListAsync();

        total = items.Sum(x => (decimal)(x.Event.price ?? 0));

        isLoading = false;
    }

    async Task CreateInvoice()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        using var transaction = await Db.Database.BeginTransactionAsync();

        try
        {
            var openItems = await Db.EventChildren
                .Include(x => x.Event)
                .Include(x => x.Child)
                .Where(x =>
                    x.Child.ParentUserId == userId &&
                    !x.IsInvoiced &&
                    x.Status == EnrollmentStatus.Confirmed)
                .ToListAsync();

            if (!openItems.Any())
                return;

            total = openItems.Sum(x => (decimal)(x.Event.price ?? 0));


            referenceNumber = GenerateISO11649(userId!);

            var invoice = new Invoice
                {
                    ParentUserId = userId!,
                    Reference = referenceNumber!,
                    TotalAmount = total,
                    CreatedAt = DateTime.Now
                };

            Db.Invoices.Add(invoice);

            //FIRST SAVE
            await Db.SaveChangesAsync();

            invoiceID = invoice.Id;
            createdInvoice = invoice;

            foreach (var item in openItems)
            {
                item.IsInvoiced = true;

                Db.InvoiceItems.Add(new InvoiceItem
                    {
                        InvoiceId = invoice.Id, // ✅ jetzt korrekt
                        EventId = item.EventId,
                        ChildId = item.ChildId,
                        Price = item.Event.price ?? 0
                    });
            }

            await Db.SaveChangesAsync();

            await transaction.CommitAsync();

            items = openItems;

            await GeneratePdf(invoice);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            Console.WriteLine(ex.ToString());
            throw;
        }
    }

    async Task GeneratePdf(Invoice invoice)
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        const int margin = 15;

        var user = await Db.Users
            .FirstOrDefaultAsync(x => x.Id == userId);

        if (user == null)
            return;

        // ----------------------------
        // QR BILL
        // ----------------------------
        var bill = new Bill
            {
                Account = IBAN,
                Creditor = new Address
                {
                    Name = CreditorName,
                    AddressLine1 = CreditorStreet,
                    AddressLine2 = CreditorCity,
                    CountryCode = "CH"
                },
                Amount = total,
                Currency = "CHF",
                Debtor = new Address
                {
                    Name = $"Familie {user.Nachname}",
                    AddressLine1 = user.Strasse,
                    AddressLine2 = $"{user.PLZ} {user.Ort}",
                    CountryCode = "CH"
                },
                Reference = invoice.Reference
            };

        byte[] qrSvgBytes = QRBill.Generate(bill);

        qrSvg = System.Text.Encoding.UTF8.GetString(qrSvgBytes);

        byte[] qrPng = ConvertSvgToPng(qrSvgBytes);

        // ----------------------------
        // PDF SETUP
        // ----------------------------
        using var document = new PdfDocument();

        var page = document.AddPage();

        page.Width = XUnit.FromMillimeter(210);
        page.Height = XUnit.FromMillimeter(297);

        XGraphics gfx = XGraphics.FromPdfPage(page);

        var titleFont = new XFont("Arial", 20);
        var textFont = new XFont("Arial", 12);

        var contentWidth = page.Width - 2 * margin;

        double y = margin;

        // ----------------------------
        // HEADER WITH LOGO
        // ----------------------------
        var logoPath = Path.Combine(
            Env.WebRootPath,
            "Bilder",
            "Ferienspass.png");

        double heightsize = 500;
        double widthsize = 100;

        if (File.Exists(logoPath))
        {
            using var logoStream = File.OpenRead(logoPath);
            using var logo = XImage.FromStream(() => logoStream);

            gfx.DrawImage(
                logo,
                margin,
                y,
                heightsize,
                widthsize);
        }

        y += 120;

        // ----------------------------
        // TABLE LAYOUT
        // ----------------------------
        double colName = margin;
        double colEvent = margin + 200;
        double colPrice = page.Width - margin - 100;

        // ----------------------------
        // TABLE HEADER METHOD
        // ----------------------------
        void DrawTableHeader()
        {
            gfx.DrawString(
                "Kind",
                textFont,
                XBrushes.Black,
                new XRect(colName, y, 200, 20),
                XStringFormats.TopLeft);

            gfx.DrawString(
                "Event",
                textFont,
                XBrushes.Black,
                new XRect(colEvent, y, 250, 20),
                XStringFormats.TopLeft);

            gfx.DrawString(
                "Preis",
                textFont,
                XBrushes.Black,
                new XRect(colPrice, y, 100, 20),
                XStringFormats.TopRight);

            y += 25;

            gfx.DrawLine(
                XPens.Black,
                margin,
                y,
                page.Width - margin,
                y);

            y += 15;
        }

        // ----------------------------
        // FIRST TABLE HEADER
        // ----------------------------
        DrawTableHeader();

        // ----------------------------
        // ITEMS
        // ----------------------------
        foreach (var item in items)
        {
            // Neue Seite wenn nötig
            if (y > page.Height - 250)
            {
                page = document.AddPage();

                page.Width = XUnit.FromMillimeter(210);
                page.Height = XUnit.FromMillimeter(297);

                gfx.Dispose();

                gfx = XGraphics.FromPdfPage(page);

                y = margin;

                DrawTableHeader();
            }

            gfx.DrawString(
                item.Child.Name,
                textFont,
                XBrushes.Black,
                new XRect(colName, y, 200, 20),
                XStringFormats.TopLeft);

            gfx.DrawString(
                item.Event.Eventname,
                textFont,
                XBrushes.Black,
                new XRect(colEvent, y, 250, 20),
                XStringFormats.TopLeft);

            gfx.DrawString(
                $"CHF {item.Event.price:0.00}",
                textFont,
                XBrushes.Black,
                new XRect(colPrice, y, 100, 20),
                XStringFormats.TopRight);

            y += 22;
        }

        y += 20;

        // ----------------------------
        // TOTAL
        // ----------------------------
        gfx.DrawString(
            $"Total: CHF {total:0.00}",
            new XFont("Arial", 14),
            XBrushes.Black,
            new XRect(margin, y, contentWidth, 30),
            XStringFormats.TopRight);

        // ----------------------------
        // QR CODE
        // ----------------------------
        using var ms = new MemoryStream(qrPng);

        using var image = XImage.FromStream(() => ms);

        double qrSizeheight = 300;
        double qrSizewidth = 550;

        gfx.DrawImage(
            image,
            page.Width - margin - qrSizewidth,
            page.Height - margin - qrSizeheight,
            qrSizewidth,
            qrSizeheight);

        // ----------------------------
        // STORAGE
        // ----------------------------
        var folder = Path.Combine(
            Env.ContentRootPath,
            "PrivateFiles",
            "Rechnungen");

        if (!Directory.Exists(folder))
            Directory.CreateDirectory(folder);

        pdfFileName = $"rechnung_{invoice.Id}.pdf";

        var path = Path.Combine(folder, pdfFileName);

        document.Save(path);

        gfx.Dispose();
    }

    string GenerateISO11649(string input)
    {
        var cleaned = new string(input.ToUpper()
            .Where(char.IsLetterOrDigit)
            .ToArray());

        cleaned = cleaned.Length > 21 ? cleaned[..21] : cleaned;

        var rearranged = cleaned + "RF00";

        var numeric = "";

        foreach (var c in rearranged)
        {
            if (char.IsDigit(c))
                numeric += c;
            else
                numeric += (c - 'A' + 10).ToString();
        }

        int mod = Mod97(numeric);
        int checkDigits = 98 - mod;

        return $"RF{checkDigits:00}{cleaned}";
    }

    int Mod97(string number)
    {
        int remainder = 0;

        foreach (char c in number)
        {
            remainder = (remainder * 10 + (c - '0')) % 97;
        }

        return remainder;
    }

    byte[] ConvertSvgToPng(byte[] svgData)
    {
        using var svg = new Svg.Skia.SKSvg();

        svg.Load(new MemoryStream(svgData));

        var picture = svg.Picture;

        var width = (int)picture.CullRect.Width;
        var height = (int)picture.CullRect.Height;

        using var bitmap = new SKBitmap(width, height);

        using var canvas = new SKCanvas(bitmap);

        canvas.Clear(SKColors.White);

        canvas.DrawPicture(picture);

        using var image = SKImage.FromBitmap(bitmap);

        using var data = image.Encode(SKEncodedImageFormat.Png, 100);

        return data.ToArray();
    }

    string GetTwintUrl()
    {
        if (createdInvoice == null)
            return "https://pay.raisenow.io/fgyzv?lng=en";

        var amount = createdInvoice.TotalAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        var reference = Uri.EscapeDataString(createdInvoice.Reference);

        return $"https://pay.raisenow.io/fgyzv?lng=en&reference.campaign_id={reference}&amount.values={amount}";
    }
}
@page "/user/rechnungen"

@using Microsoft.EntityFrameworkCore
@using FerienspassWebApp.Models
@using FerienspassWebApp.Data
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "Admin,Kursleiter,Eltern")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider

<h3>Meine Rechnungen</h3>

@if (!invoices.Any())
{
    <p>Keine Rechnungen vorhanden.</p>
}
else
{
    @foreach (var invoice in pagedInvoices)
    {
        <div style="border:1px solid #ccc; padding:15px; margin-bottom:10px; border-radius:10px;">

            <h4>Rechnung @invoice.Reference</h4>

            <p>
                Datum:
                @invoice.CreatedAt.ToString("dd.MM.yyyy")
            </p>

            <p>
                Total:
                CHF @invoice.TotalAmount
            </p>

            <p>
                Status:
                <span style="color:@GetColor(invoice.Status)">
                    @GetText(invoice.Status)
                </span>
            </p>

            @if (invoice.Status == InvoiceStatus.Paid)
            {
                <p>
                    Bezahlt am:
                    @invoice.PaidAt?.ToString("dd.MM.yyyy")
                </p>
            }

            <a class="btn btn-primary"
               href="@($"/api/invoices/{invoice.Id}/download")"
               target="_blank">
                PDF öffnen
            </a>

        </div>
    }
    @if (totalPages > 1)
    {
        <div class="mt-3" style="display:flex; gap:8px; flex-wrap:wrap;">

            <button class="btn btn-secondary"
                    @onclick="PreviousPage"
                    disabled="@(currentPage == 1)">
                ← Zurück
            </button>

            @for (int i = 1; i <= totalPages; i++)
            {
                var pageNumber = i;

                <button class="btn @(pageNumber == currentPage ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => GoToPage(pageNumber)">
                    @pageNumber
                </button>
            }

            <button class="btn btn-secondary"
                    @onclick="NextPage"
                    disabled="@(currentPage == totalPages)">
                Weiter →
            </button>

        </div>
    }
}


@code {

    private List<Invoice> invoices = new();
    private int currentPage = 1;
    private const int pageSize = 10;

    private List<Invoice> pagedInvoices =>
        invoices
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

    private int totalPages =>
        (int)Math.Ceiling(invoices.Count / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();

        var userId = auth.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)
            ?.Value;

        invoices = await Db.Invoices
            .Where(x => x.ParentUserId == userId)
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();

        if (currentPage > totalPages)
        {
            currentPage = totalPages == 0 ? 1 : totalPages;
        }
    }

    string GetColor(InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Open => "orange",
            InvoiceStatus.Reminder => "red",
            InvoiceStatus.Paid => "green",
            _ => "black"
        };
    }

    string GetText(InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Open => "Offen",
            InvoiceStatus.Reminder => "Mahnung",
            InvoiceStatus.Paid => "Bezahlt",
            _ => "-"
        };
    }

    void GoToPage(int page)
    {
        currentPage = page;
    }

    void NextPage()
    {
        if (currentPage < totalPages)
            currentPage++;
    }

    void PreviousPage()
    {
        if (currentPage > 1)
            currentPage--;
    }
}
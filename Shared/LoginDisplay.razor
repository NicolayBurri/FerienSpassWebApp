<AuthorizeView>
    <Authorized>
        <nav class="navbar custom-navbar">

            <div class="left-side"></div>

            <div class="center">
                <picture>
                    <source media="(max-widht:100; height:auto;)" srcset="Bilder/Ferienspass.png" />
                    <img src="Bilder/Ferienspass.png" alt="Ferienspass" class="responsive-img" />
                </picture>
            </div>

            <div class="right-side">

                <a href="Identity/Account/Manage">
                    Logindaten ändern
                </a>

                <form method="post" action="/Identity/Account/Logout">
                    <button type="submit" class="btn btn-link">
                        Log out
                    </button>
                </form>

            </div>

        </nav>
    </Authorized>

    <NotAuthorized>
        <nav class="navbar custom-navbar">

            <div class="left-side"></div>

            <div class="center">
                <picture>
                    <source media="(max-widht:100; height:auto;)" srcset="Bilder/Ferienspass.png" class="responsive-img" />
                    <img src="Bilder/Ferienspass.png" alt="Ferienspass" />
                </picture>
            </div>

            <div class="right-side">
                <a href="Identity/Account/Register">Register</a>
                <a href="Identity/Account/Login">Log in</a>
            </div>

        </nav>
    </NotAuthorized>
</AuthorizeView>
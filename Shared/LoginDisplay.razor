@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <nav class="navbar custom-navbar">

            <div class="left-side">

                <a href="/F&Q"
                   title="Fragen und Antworten"
                   style="
                        display:flex;
                        justify-content:center;
                        align-items:center;
                        width:36px;
                        height:36px;
                        border-radius:50%;
                        background:#0d6efd;
                        color:white;
                        text-decoration:none;
                        font-size:22px;
                        font-weight:bold;">
                    ?
                </a>
            </div>

            <div class="center">
                <picture>
                    <source media="(max-width:100%; height:auto;)" srcset="Bilder/Ferienspass.png" />
                    <img src="Bilder/Ferienspass.png" alt="Ferienspass" class="responsive-img" />
                </picture>
            </div>

            <div class="right-side">

                <a href="Identity/Account/Manage">
                    Logindaten ändern
                </a>

                <form method="post" action="/Identity/Account/Logout">
                    <button type="submit" class="btn btn-link">
                        Log out
                    </button>
                </form>

            </div>

        </nav>
    </Authorized>

    <NotAuthorized>
        <nav class="navbar custom-navbar">

            <div class="left-side">

                <a href="/F&Q"
                   title="Fragen und Antworten"
                   style="
                        display:flex;
                        justify-content:center;
                        align-items:center;
                        width:40px;
                        height:40px;
                        margin-left:10px;
                        border-radius:50%;
                        background:#0d6efd;
                        color:white;
                        text-decoration:none;
                        font-size:22px;
                        font-weight:bold;">
                    ?
                </a>

            </div>

            <div class="center">
                <picture>
                    <source media="(max-width:100%; height:auto;)" srcset="Bilder/Ferienspass.png" />
                    <img src="Bilder/Ferienspass.png" alt="Ferienspass" class="responsive-img" />
                </picture>
            </div>

            <div class="right-side">

                <a href="Identity/Account/Register">Register</a>
                <a href="Identity/Account/Login">Log in</a>

            </div>

        </nav>
    </NotAuthorized>
</AuthorizeView>
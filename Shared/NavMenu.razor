@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using FerienspassWebApp.Models

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FerienspassWebApp</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Kalender">
                <span class="oi oi-calendar" aria-hidden="true"></span> Event Kalender
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="AGBs">
                <span class="oi oi-info" aria-hidden="true"></span> AGBs
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Kontakte">
                <span class="oi oi-phone" aria-hidden="true"></span> Kontakte
            </NavLink>
        </div>
    </nav>
    <AuthorizeView Roles="Admin,Kursleiter,Eltern">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="User/Konto">
                <span class="oi oi-phone" aria-hidden="true"></span> Konto
            </NavLink>
        </div>
    </AuthorizeView>

    @if (IsProfileComplete)
    {
        <AuthorizeView Roles="Admin,Kursleiter,Eltern">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="User/Kalender">
                    <span class="oi oi-list" aria-hidden="true"></span> Eventliste
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Kursleiter,Eltern">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="User/Rechnung-erstellen">
                    <span class="oi oi-basket" aria-hidden="true"></span> Rechnung Erstellen
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Kursleiter,Eltern">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="User/Rechnungen">
                    <span class="oi oi-briefcase" aria-hidden="true"></span> Rechnungen Einsehen
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Kursleiter,Eltern">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="User/Children">
                    <span class="oi oi-person" aria-hidden="true"></span> Kinder
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Kursleiter">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Kursleiter/Event Erstellen">
                    <span class="oi oi-command" aria-hidden="true"></span> Event Erstellen
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Kursleiter">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Kursleiter/Events">
                    <span class="oi oi-book" aria-hidden="true"></span> Event Liste
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Kursleiter">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Kursleiter/Rechnungen">
                    <span class="oi oi-document" aria-hidden="true"></span> Rechnungen
                </NavLink>
            </div>
        </AuthorizeView>

    }
    <AuthorizeView Roles="Admin">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Admin/Users">
                <span class="oi oi-person" aria-hidden="true"></span> Admin Panel
            </NavLink>
        </div>
    </AuthorizeView>
    <AuthorizeView Roles="Admin">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Admin/Systemeinstellungen">
                <span class="oi oi-clock" aria-hidden="true"></span> Anmeldefenster
            </NavLink>
        </div>
    </AuthorizeView>
    <AuthorizeView Roles="Admin">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Admin/Fehlende-rechnungen">
                <span class="oi oi-warning" aria-hidden="true"></span> Ausstehende Rechnungen
            </NavLink>
        </div>
    </AuthorizeView>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool IsProfileComplete = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckProfileComplete();
    }

    private async Task CheckProfileComplete()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated == true)
        {
            var user = await UserManager.GetUserAsync(principal);

            IsProfileComplete =
                !string.IsNullOrWhiteSpace(user?.Vorname) &&
                !string.IsNullOrWhiteSpace(user?.Nachname) &&
                !string.IsNullOrWhiteSpace(user?.Strasse) &&
                !string.IsNullOrWhiteSpace(user?.PLZ) &&
                !string.IsNullOrWhiteSpace(user?.Ort) &&
                !string.IsNullOrWhiteSpace(user?.Telefonnummer);
        }
    }
}
